  /* ---------- FAQ ---------- */
  .faq-section { padding-block: clamp(2.5rem, 7vh, 5rem); }
  .faq-section__head { text-align: center; }
  .faq-section__heading { margin-top: var(--space-4); margin-inline: auto; font-size: clamp(2rem, 5vw, 3.25rem); }
  .faq-section__list { margin-top: var(--space-8); }
  .faq-section__more { margin-top: var(--space-8); text-align: center; font-size: 1.5rem; color: var(--ink-50); animation: faq-more-bounce 1800ms ease-in-out infinite; }
