---
/* Home — copy pulled from 00-MASTER-OFFER.md (the offer, the guarantees,
   the delivery SOP) rather than invented from scratch. New slots that never
   existed before still carry honest, non-fabricated placeholder marks,
   flagged inline. Light throughout, centered and airy; portfolio is the
   loudest section, but capped short. Purely-decorative sections with no
   real content (the old credibility strip, work wall, atmospheric band,
   composite-visual floating tiles) were cut — they read as unlabeled
   "weird boxes" rather than earning their place on the page. FAQ stays,
   trimmed to the 4 questions that matter, right before the final CTA.
   Signature motion: the large statement-style headings (portfolio heading,
   statement, closing) resolve from near-invisible to full contrast on
   scroll. Respects reduced-motion. */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import FAQ from '../components/FAQ.astro';
import PortfolioMarquee from '../components/PortfolioMarquee.astro';
import { site } from '../data/site.config';
import { homeFaqs } from '../data/faqs';
import { priceCards } from '../data/pricing';

// All 4 broad FAQ questions (each already rolls up several real objections).
const topFaqs = homeFaqs;

// Blueprint — THREE plain-language steps (what actually happens, in order),
// not the jargon-heavy version from the offer doc.
const blueprint = [
  { n: '01', heading: 'We study your niche', body: 'We study the best-converting brands in your niche to see exactly what makes them convert (layout, copy, checkout flow) before writing a line of code.' },
  { n: '02', heading: 'We build your store', body: 'Homepage, product pages, cart, and checkout: all built from scratch around what we learned, optimized for how your customers actually buy.' },
  { n: '03', heading: 'We keep optimizing until it wins', body: 'Once it’s live, we track your real numbers (add-to-cart rate, checkout drop-off, mobile vs. desktop) and keep testing changes against them. If it’s not beating your old numbers, we keep working for free until it is.' },
]; // TODO real screenshot/mockup per row

// "14 days from today" — computed at build so the date in the final CTA
// stays real on every deploy instead of hardcoding one that goes stale.
const fourteen = new Date(Date.now() + 14 * 24 * 60 * 60 * 1000);
const ordinal = (n: number) => {
  const s = ['th', 'st', 'nd', 'rd'];
  const v = n % 100;
  return `${n}${s[(v - 20) % 10] || s[v] || s[0]}`;
};
const fourteenLabel = `${fourteen.toLocaleDateString('en-US', { month: 'long' })} ${ordinal(fourteen.getDate())}`;
---
<BaseLayout
  title="Conversion-Built Shopify Stores for Brands Doing $40k+/Month"
  description="FlipFix Digital rebuilds Shopify storefronts for consumer brands doing $40k+ a month. Live in 14 days or you don't pay, then measured against your old numbers on your own analytics."
>
  <!-- soft gradient wash behind the hero only, fading to flat bg by the fold -->
  <div class="hero-wash" aria-hidden="true"></div>

  <!-- 2. HERO -->
  <section class="hero">
    <div class="container">
      <h1 class="hero__h1"><span>Premium converting websites</span><span>for consumer brands</span></h1>
    </div>
    <div class="container">
      <p class="hero__sub">Live in 14 days, then we work for free until it beats your conversion rate.</p>
    </div>

    <!-- 3. VSL — autoplay muted loop when a file is wired. Until then a
         clearly-marked placeholder; the circular button is the unmute
         control (unmuting restarts from 0). Scrubbing/seeking ahead is
         blocked — this is a watch-through video, not a scrubbable player.
         Drop /video/vsl.mp4 + set data-src to go live. -->
    <div class="container hero__video">
      <div class="vsl" data-vsl>
        <video class="vsl__media" autoplay muted loop playsinline preload="none" disablepictureinpicture controlslist="nodownload noplaybackrate" data-src="" aria-label="Founder VSL (placeholder)"></video>
        <div class="vsl__poster" aria-hidden="true">
          <span class="vsl__wordmark">{site.wordmark.lead} <span>{site.wordmark.accent}</span></span>
        </div>
        <button type="button" class="vsl__unmute" data-vsl-unmute aria-label="Unmute video">
          <span class="vsl__unmute-icon" aria-hidden="true">▶</span>
        </button>
      </div>
    </div>

    <!-- CTA BLOCK -->
    <div class="container">
      <div class="hero__cta">
        <CtaBlock event="Hero" />
      </div>
    </div>
  </section>

  <!-- 4. PORTFOLIO — moving marquee, not a static grid -->
  <section class="pf" id="portfolio">
    <div class="container">
      <p class="eyebrow-num mono">01. Portfolio</p>
      <h2 class="pf__heading stmt">Be the next success story.</h2>
    </div>
    <div class="pf__marquee" data-reveal>
      <PortfolioMarquee />
    </div>
  </section>

  <!-- 6. PRICING (two offers) -->
  <section class="pricing" id="pricing">
    <div class="container pricing__head">
      <p class="eyebrow-num mono">02. Pricing</p>
      <h2 class="pricing__heading">Built to convert like crazy.</h2>
      <p class="pricing__sub">Two different offers, both designed to increase your conversions and revenue.</p>
    </div>
    <div class="container">
      <div class="pricing__grid">
        {priceCards.map((c, i) => (
          <div class:list={['pcard', { 'pcard--featured': c.featured }]} data-reveal style={`transition-delay:${i * 90}ms`}>
            {c.featured && <p class="pcard__tag mono">Most booked</p>}
            <p class="pcard__name mono">{c.name}</p>
            <p class="pcard__desc">{c.description}</p>
            <p class="pcard__price">
              <span data-count-to={c.price.replace(/\D/g, '')} data-count-prefix="$">{c.price}</span>
              <span class="pcard__qual">{c.qualifier}</span>
            </p>
            <a class="btn btn--primary btn--pill pcard__cta" href={`${site.cta.href}?from=${encodeURIComponent(c.event)}`} data-event={c.event}><span class="btn__label">{c.cta}</span></a>
            <hr class="pcard__divider" />
            <ul class="pcard__features">
              {c.features.map((f) => <li data-reveal-child>{f}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA BLOCK -->
    <div class="pricing__cta">
      <CtaBlock event="Pricing" />
    </div>
  </section>

  <!-- short single-review proof — placeholder until a real one exists -->
  <section class="proof">
    <div class="container proof__grid">
      <div class="proof__inner" data-reveal>
        <p class="proof__quote">“Real client review goes here once the first build ships.”</p>
        <p class="proof__name">Client Name <span class="proof__brand">(Brand, TODO)</span></p>
        <!-- TODO real numbers once the first build ships: honest placeholder, not invented -->
        <div class="proof__stats">
          <div class="proof__stat" data-reveal-child>
            <span class="proof__stat-value mono">TBD</span>
            <span class="proof__stat-label">Conversion rate (TODO)</span>
          </div>
          <div class="proof__stat" data-reveal-child>
            <span class="proof__stat-value mono">TBD</span>
            <span class="proof__stat-label">Revenue added (TODO)</span>
          </div>
        </div>
      </div>
      <!-- TODO replace with a large screenshot of the finished build -->
      <div class="proof__shot" aria-hidden="true">
        <span class="proof__shot-label mono">Screenshot (TODO)</span>
      </div>
    </div>
  </section>

  <!-- 8. STATEMENT SECTION -->
  <section class="statement">
    <div class="container">
      <p class="eyebrow-num mono eyebrow-num--center">03. The Problem</p>
      <p class="statement__line stmt">You need a website that can <span class="statement__emph">reliably scale</span> with you.</p>
      <p class="statement__sub">Stop running a plain Shopify template that looks like everyone else’s. Generic themes cap your conversion rate, no matter how big you grow.</p>
    </div>
  </section>

  <!-- before / after — TODO real screenshots once the first build ships.
       Draggable comparison slider: a native range input drives --pos, which
       clips the "after" layer and positions the divider, so it's fully
       keyboard/touch/screen-reader accessible for free. -->
  <section class="ba">
    <div class="container">
      <div class="ba-slider" data-reveal>
        <div class="ba-slider__frame" data-ba-frame style="--pos:50%">
          <div class="ba-slider__pane ba-slider__pane--before">
            <span class="ba-slider__ph mono">Screenshot (TODO)</span>
          </div>
          <div class="ba-slider__pane ba-slider__pane--after">
            <span class="ba-slider__ph mono">Screenshot (TODO)</span>
          </div>
          <span class="ba-slider__tag ba-slider__tag--before mono">Before</span>
          <span class="ba-slider__tag ba-slider__tag--after mono">After</span>
          <input class="ba-slider__range" type="range" min="0" max="100" step="0.1" value="50" data-ba-range aria-label="Drag to compare the before and after site" />
          <div class="ba-slider__divider" aria-hidden="true">
            <span class="ba-slider__handle">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 6 2 12l6 6M16 6l6 6-6 6"></path>
              </svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- 10. THE BLUEPRINT -->
  <section class="bp">
    <div class="container bp__head">
      <p class="eyebrow-num mono eyebrow-num--center">04. The Blueprint</p>
      <h2 class="bp__intro">Here’s exactly how we improve your ad results.</h2>
      <p class="bp__sub">We build you the best-converting site, and guarantee it works, because we don’t stop until it does.</p>
    </div>
    <div class="container bp__rows">
      {blueprint.map((row) => (
        <div class="bp__row">
          <div class="bp__row-text">
            <span class="bp__n mono">{row.n}</span>
            <h3 class="bp__row-heading">{row.heading}</h3>
            <p class="bp__row-body">{row.body}</p>
          </div>
          <div class="bp__row-visual" data-reveal aria-hidden="true">
            {row.n === '01' && (
              <div class="bp__scene bp__scene--research">
                <span class="rs__card rs__card--1"><span class="rs__bar"></span><span class="rs__line"></span><span class="rs__line rs__line--sm"></span></span>
                <span class="rs__card rs__card--2"><span class="rs__bar"></span><span class="rs__line"></span><span class="rs__line rs__line--sm"></span></span>
                <span class="rs__card rs__card--3"><span class="rs__bar"></span><span class="rs__line"></span><span class="rs__line rs__line--sm"></span></span>
                <span class="rs__glass"><span class="rs__glass-ring"></span><span class="rs__glass-handle"></span></span>
              </div>
            )}
            {row.n === '02' && (
              <div class="bp__scene bp__scene--build">
                <div class="bd__frame">
                  <div class="bd__chrome"><span></span><span></span><span></span></div>
                  <div class="bd__page">
                    <span class="bd__hero"></span>
                    <div class="bd__row">
                      <span class="bd__tile"></span>
                      <span class="bd__tile"></span>
                    </div>
                    <span class="bd__cart"></span>
                  </div>
                </div>
              </div>
            )}
            {row.n === '03' && (
              <div class="bp__scene bp__scene--optimize">
                <div class="op__chart">
                  <span class="op__bar op__bar--1"></span>
                  <span class="op__bar op__bar--2"></span>
                  <span class="op__bar op__bar--3"></span>
                  <span class="op__bar op__bar--4"></span>
                </div>
                <svg class="op__trend" viewBox="0 0 100 60" preserveAspectRatio="none">
                  <polyline points="4,50 27,36 50,40 74,16 96,6"></polyline>
                </svg>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ (top 4 questions) -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-section__head">
        <p class="eyebrow-num mono eyebrow-num--center">05. FAQ</p>
        <h2 class="faq-section__heading stmt">Common Questions</h2>
      </div>
      <div class="faq-section__list"><FAQ items={topFaqs} /></div>
      <p class="faq-section__more" aria-hidden="true">↓</p>
    </div>
  </section>

  <!-- 11. FINAL CTA (dark) — right before the footer. The page's thesis
       statement, made the loudest visual on the page: an oversized
       count-up on "14" plus an animated today-to-launch timeline. -->
  <section class="closing section--dark">
    <div class="container closing__inner">
      <h2 class="closing__h stmt">
        <span class="closing__h-days"><span data-count-to="14">14</span> days</span> from today is {fourteenLabel}.
      </h2>
      <div class="countdown-track" data-reveal aria-hidden="true">
        <span class="countdown-track__point">
          <span class="countdown-track__dot"></span>
          <span class="mono">Today</span>
        </span>
        <span class="countdown-track__bar"><span class="countdown-track__fill"></span></span>
        <span class="countdown-track__point">
          <span class="countdown-track__dot countdown-track__dot--end"></span>
          <span class="mono">{fourteenLabel}</span>
        </span>
      </div>
      <p>Between now and then you’ll pay for every visitor who lands on the page you have right now. That cost is the same whether they buy or leave. You’ve been changing ads, offers, and audiences for months while the page stayed where it was, and 14 days is how long it takes to change that.</p>
      <p>Tap the button, fill out the short form, pick a time. The person who reads it and shows up to that call is me.</p>
      <p class="closing__alt">Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="closing__cta">
        <CtaBlock event="Closing" />
      </div>
      <p class="closing__sig">{site.founder}, {site.brand}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // ---- Signature motion: statement-style headings resolve on scroll ----
  (function () {
    var stmts = Array.prototype.slice.call(document.querySelectorAll('.stmt'));
    if (!stmts.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var litAll = function () { stmts.forEach(function (s) { s.classList.add('is-lit'); }); };
    if (reduce || !('IntersectionObserver' in window)) { litAll(); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-lit'); io.unobserve(e.target); } });
    }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
    stmts.forEach(function (s) { io.observe(s); });
    // failsafe: never leave a heading stuck faint
    window.addEventListener('load', function () { setTimeout(litAll, 1400); });
  })();

  // ---- Before/after comparison slider: sync the range input's value to
  // the --pos custom property that drives the clip-path + divider ----
  (function () {
    var frame = document.querySelector('[data-ba-frame]');
    var range = document.querySelector('[data-ba-range]');
    if (!frame || !range) return;
    var update = function () { frame.style.setProperty('--pos', range.value + '%'); };
    range.addEventListener('input', update);
    update();
  })();

  // ---- VSL: unmute control (inert until a real file is wired) ----
  (function () {
    var vsl = document.querySelector('[data-vsl]');
    if (!vsl) return;
    var media = vsl.querySelector('.vsl__media');
    var btn = vsl.querySelector('[data-vsl-unmute]');
    if (!media || !btn) return;
    // If a source is present, start the muted autoplay loop.
    var src = media.getAttribute('data-src');
    if (src) { media.src = src; media.play().catch(function () {}); vsl.classList.add('has-video'); }

    // This is a watch-through video, not a scrubbable player: block seeking
    // forward past where playback naturally reached (native controls are
    // never shown, but context-menu/keyboard seeking is still possible).
    var maxReached = 0;
    media.addEventListener('timeupdate', function () { if (!media.seeking) maxReached = media.currentTime; });
    media.addEventListener('seeking', function () { if (media.currentTime > maxReached + 0.5) media.currentTime = maxReached; });

    btn.addEventListener('click', function () {
      if (!media.getAttribute('src')) return; // nothing wired yet
      var wasMuted = media.muted;
      media.muted = !wasMuted;
      btn.setAttribute('aria-label', media.muted ? 'Unmute video' : 'Mute video');
      vsl.classList.toggle('is-unmuted', !media.muted);
      // unmuting is a deliberate "watch it properly" action — start over
      if (wasMuted) { media.currentTime = 0; maxReached = 0; }
      if (media.paused) media.play().catch(function () {});
    });
  })();

</script>

<style>
  /* ---------- hero load sequence (runs once on arrival, no re-trigger) ----------
     Logo (Nav.astro, self-contained) fades first, then the headline lines
     stagger up, subhead follows, CTA + the 3-step process strip stagger in
     last. Delays overlap rather than chain off full durations so the whole
     thing lands under ~1s instead of stacking to a slow crawl. */
  @keyframes hero-rise { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  .js .hero__h1 span { opacity: 0; animation: hero-rise 500ms var(--ease-out) forwards; }
  .js .hero__h1 span:nth-child(1) { animation-delay: 100ms; }
  .js .hero__h1 span:nth-child(2) { animation-delay: 160ms; }
  .js .hero__sub { opacity: 0; animation: hero-rise 450ms var(--ease-out) 260ms forwards; }
  .js .hero__cta :global(.cta-block) { opacity: 0; animation: hero-rise 450ms var(--ease-out) 360ms forwards; }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(1)),
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(3)),
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(5)) {
    opacity: 0; animation: hero-rise 400ms var(--ease-out) forwards;
  }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(1)) { animation-delay: 440ms; }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(3)) { animation-delay: 520ms; }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(5)) { animation-delay: 600ms; }

  /* ---------- soft hero wash (behind hero only) ---------- */
  .hero-wash {
    position: absolute; inset: 0 0 auto 0; height: 96vh; z-index: 0; pointer-events: none;
    background:
      radial-gradient(80% 60% at 50% 12%, color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 60%),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent) 5%, var(--bg)) 0%, var(--bg) 62%);
  }

  /* ---------- shared: numbered section eyebrow ---------- */
  .eyebrow-num { font-size: var(--fs-eyebrow); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--ink-50); }
  .eyebrow-num--center { text-align: center; }

  /* ---------- 2. HERO ---------- */
  /* nav is a regular in-flow bar now (not a floating overlay), so the hero
     no longer needs to reserve space to clear it. Spacing matches the
     reference done-for-you hero: space-12 top, space-6 to the video,
     space-5 to the CTA. */
  .hero { position: relative; z-index: 1; padding-top: var(--space-12); padding-bottom: var(--space-10); text-align: center; }
  /* inherits the global h1 (uppercase Archivo display, var(--fs-h1)) — only
     margin/max-width are overridden, same as the reference hero. ch scales
     with the font itself, so "Premium converting websites" stays on one
     line at any viewport instead of wrapping mid-phrase. */
  .hero__h1 { max-width: 34ch; margin-inline: auto; font-size: clamp(2.25rem, 4.4vw, 3.75rem); }
  .hero__h1 span { display: block; }
  .hero__sub { margin: var(--space-5) auto 0; max-width: 44ch; font-family: var(--font-serif); font-style: italic; font-size: var(--fs-lede); color: var(--ink-soft); }
  .hero__video { margin-top: var(--space-6); }
  .hero__cta { margin-top: var(--space-5); }

  /* ---------- 3. VSL ---------- */
  .vsl {
    position: relative; width: 100%; max-width: 68rem; aspect-ratio: 16 / 9;
    margin-inline: auto; border-radius: 16px; overflow: hidden;
    background: #0f120e; box-shadow: 0 40px 80px -40px rgba(26, 24, 20, 0.5);
    display: flex; align-items: center; justify-content: center;
  }
  .vsl__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vsl__poster {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: radial-gradient(120% 120% at 50% 40%, rgba(158,123,61,0.14), transparent 60%), linear-gradient(160deg, #14170f, #0d0f0b);
  }
  .vsl.has-video .vsl__poster { display: none; }
  .vsl__wordmark { font-family: var(--font-display); font-weight: var(--fw-display); text-transform: uppercase; font-size: clamp(1.25rem, 4vw, 2.25rem); color: var(--dark-ink); letter-spacing: 0.01em; }
  .vsl__wordmark span { color: var(--accent-strong); }
  .vsl__unmute {
    position: absolute; z-index: 1; width: 72px; height: 72px; border-radius: 50%;
    border: 2px solid var(--dark-ink); background: color-mix(in srgb, var(--dark-ink) 12%, transparent);
    color: var(--dark-ink); font-size: 1.4rem; line-height: 1; padding-left: 4px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: transform var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .vsl__unmute:hover { transform: scale(1.06); background: color-mix(in srgb, var(--dark-ink) 22%, transparent); }

  /* ---------- signature statement motion ---------- */
  .stmt { transition: opacity 800ms var(--ease-out), color 800ms var(--ease-out); }
  .js .stmt { opacity: 0.14; }
  .js .stmt.is-lit { opacity: 1; }

  /* ---------- 4. PORTFOLIO ---------- */
  .pf { padding-top: var(--space-12); padding-bottom: var(--space-10); }
  .pf__heading { margin-top: var(--space-4); max-width: 20ch; font-size: clamp(2.25rem, 6vw, 4.5rem); color: var(--ink-soft); text-align: left; }
  /* full-bleed: the marquee drifts edge to edge, unconstrained by the text container above it */
  .pf__marquee { margin-top: var(--space-8); }

  /* ---------- 8 / 11. STATEMENT-STYLE HEADINGS ---------- */
  .statement { padding-top: clamp(3rem, 8vh, 5rem); padding-bottom: clamp(1.5rem, 3vh, 2.5rem); text-align: center; }
  .statement__line { text-align: center; margin-inline: auto; margin-top: var(--space-5); max-width: 22ch; font-family: var(--font-display); font-weight: var(--fw-display); font-size: clamp(2rem, 5.5vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); }
  .statement__emph { color: var(--accent-deep); }
  .statement__sub { margin: var(--space-5) auto 0; max-width: 48ch; font-family: var(--font-serif); font-size: var(--fs-lede); line-height: 1.6; color: var(--ink-soft); }

  /* ---------- before / after: draggable comparison slider ---------- */
  .ba { padding-block: clamp(2rem, 6vh, 4rem); }
  .ba-slider { max-width: 64rem; margin-inline: auto; }
  .ba-slider__frame {
    position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-md);
    border: var(--rule-width) solid var(--line); background: var(--bg-raised);
    overflow: hidden; cursor: grab; touch-action: pan-y;
  }
  .ba-slider__frame:active { cursor: grabbing; }
  /* each pane's own placeholder label sits off-center (left third / right
     third) so the two don't collide at the default 50/50 divider position;
     real screenshots will fill the whole pane and won't need this */
  .ba-slider__pane { position: absolute; inset: 0; display: flex; align-items: center; }
  .ba-slider__pane--before { justify-content: flex-start; padding-left: 12%; }
  .ba-slider__pane--after { justify-content: flex-end; padding-right: 12%; }
  .ba-slider__pane--before { background: var(--bg-raised); }
  .ba-slider__pane--after {
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-raised));
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
