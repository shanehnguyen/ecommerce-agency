  .bd__chrome { height: 14%; display: flex; align-items: center; gap: 6%; padding-inline: 8%; border-bottom: var(--rule-width) solid var(--line); background: color-mix(in srgb, var(--bp-build) 10%, var(--bg-raised)); }
  .bd__chrome span { width: 7%; aspect-ratio: 1; border-radius: 50%; background: color-mix(in srgb, var(--bp-build) 45%, var(--line)); }
  .bd__page { position: relative; height: 86%; padding: 8%; display: flex; flex-direction: column; gap: 8%; }
