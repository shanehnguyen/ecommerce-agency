---
/* CtaBlock — the repeating 2-part unit (structure spec's "CTA BLOCK"):
   pill CTA, then a 3-step process strip. Identical wording every time it's
   placed; only the tracking `event` differs per instance. Used after VSL,
   Pricing, the composite visual, and Closing. */
import Cta from './Cta.astro';
interface Props { event: string; }
const { event } = Astro.props;
---
<div class="cta-repeat">
  <Cta event={event} pill />

  <p class="cta-repeat__process mono">
    <span><span class="cta-repeat__n">01</span> Short form</span>
    <span class="cta-repeat__sep" aria-hidden="true">/</span>
    <span><span class="cta-repeat__n">02</span> 20-minute call</span>
    <span class="cta-repeat__sep" aria-hidden="true">/</span>
    <span><span class="cta-repeat__n">03</span> More revenue</span>
  </p>
</div>

<style>
  .cta-repeat { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cta-repeat :global(.cta-block) { margin: 0; }

  .cta-repeat__process {
    margin-top: var(--space-6); display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: var(--space-2) var(--space-4); font-size: var(--fs-small); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--ink-soft);
  }
  .cta-repeat__n { color: var(--accent-deep); font-weight: var(--fw-body-bold); }
  .cta-repeat__sep { color: var(--line); }

  /* on a dark section (e.g. the final CTA), swap to the dark-safe palette */
  :global(.section--dark) .cta-repeat__process { color: var(--dark-soft); }
  :global(.section--dark) .cta-repeat__n { color: var(--accent-strong); }
  :global(.section--dark) .cta-repeat__sep { color: var(--dark-line); }
</style>
