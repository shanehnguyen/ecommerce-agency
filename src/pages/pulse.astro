  .pl-badge { font-size: var(--fs-caption); font-weight: var(--fw-body-semi); color: #fff; padding: 1px 7px; border-radius: 999px; white-space: nowrap; }
  .pl-dash { color: color-mix(in srgb, var(--ink) 25%, #fff); }
  .pl-anon { color: var(--ink-50); font-style: italic; }
  .pl-entry--cta { color: #3F7F4F; font-weight: var(--fw-body-semi); }
  .pl-entry--ad { color: #A9722B; font-weight: var(--fw-body-semi); }
  .pl-entry--ref { color: var(--ink-70); }
  .pl-entry--direct { color: var(--ink-50); }

  /* row-expand detail */
  .pl-detail td { white-space: normal; background: color-mix(in srgb, var(--ink) 4%, #fff); }
  .pl-detail__in { display: grid; gap: 4px; font-size: var(--fs-caption); }
  .pl-detail__times { color: var(--ink-70); }
