---
/* PortfolioTile — one screenshot card (image + name/result overlays),
   used by PortfolioGrid. Extracted to its own component because Astro's
   frontmatter script can't contain template markup directly — only the
   template section below the second `---` can. */
import { Image } from 'astro:assets';

type Card = {
  name: string; image: ImageMetadata; zoom?: number; pos?: number;
  label?: string; fromTo?: string;
};

interface Props {
  card: Card;
}
const { card: c } = Astro.props;
---
<div
  class="pf-tile"
  data-reveal-child
  style={`${c.zoom ? `--shot-zoom:${c.zoom};` : ''}${c.pos ? `--shot-pos:${c.pos}%;` : ''}`}
>
  <Image class="pf-tile__img" src={c.image} alt={`${c.name} storefront`} width={800} format="webp" quality={90} />
  <span class="pf-tile__top">
    <span class="pf-tile__name">{c.name}</span>
  </span>
  {c.label && c.fromTo && (
    <span class="pf-tile__bottom">
      <span class="pf-tile__value mono">{c.fromTo}</span>
      <span class="pf-tile__label">{c.label}</span>
    </span>
  )}
</div>

<style>
  .pf-tile {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 16px;
    border: var(--rule-width) solid var(--line);
    /* font-sizes below scale off the TILE's own rendered width (cqw), not
       the viewport */
    container-type: inline-size;
    transition: border-color 200ms var(--ease-out), transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }
  .pf-tile:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 16px 30px -20px rgba(26, 24, 20, 0.35); }

  .pf-tile__img {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
    object-fit: cover; object-position: center var(--shot-pos, 45%);
    transform: scale(var(--shot-zoom, 1.2));
  }

  /* name + result overlay directly on the image, each on its own gradient
     scrim (same technique as .vsl__tint elsewhere on this page) so they
     stay legible regardless of what's underneath. The gradient stays solid
     through more of the band (0–55%) before fading, so a 2-line wrapped
     name doesn't drift into a near-transparent zone by its second line. */
  .pf-tile__top, .pf-tile__bottom {
    position: absolute; left: 0; right: 0; z-index: 1;
    display: flex; flex-direction: column;
    padding: var(--space-3) var(--space-4);
  }
  .pf-tile__top {
    top: 0;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--ink) 68%, transparent) 0%, color-mix(in srgb, var(--ink) 68%, transparent) 55%, transparent 100%);
  }
  .pf-tile__bottom {
    bottom: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 72%, transparent) 0%, color-mix(in srgb, var(--ink) 72%, transparent) 55%, transparent 100%);
  }

  /* hard-capped at 2 lines (ellipsized beyond that) so a long name can never
     grow tall enough to run into the bottom overlay, whatever the tile width. */
  .pf-tile__name {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    font-size: clamp(11px, 5cqw, 17px); font-weight: var(--fw-body-semi); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--bg);
  }
  /* before → after (e.g. "1.2% → 3.4%"), not just the final number — sized
     smaller than the old single-number display since it's a longer string
     (the PK Cabinets one, "$2,081 → $5,556", is the longest at 16 chars). */
  .pf-tile__value { font-size: clamp(0.9rem, 5cqw, 1.4rem); font-weight: var(--fw-body-bold); color: var(--bg); line-height: 1.25; }
  .pf-tile__label { margin-top: var(--space-1); font-size: clamp(9px, 3.5cqw, 14px); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: color-mix(in srgb, var(--bg) 80%, transparent); }
</style>
