  .pl-empty { color: var(--ink-50); font-size: var(--fs-body-sm, var(--fs-caption)); text-align: center; padding: var(--space-6); }

  .pl-note { margin-top: var(--space-6); font-size: var(--fs-body-sm, var(--fs-caption)); color: var(--ink-70); }
