  .bd__cart { display: block; height: 16%; border-radius: 6px; background: color-mix(in srgb, var(--bp-build) 30%, var(--bg-raised)); border: var(--rule-width) solid color-mix(in srgb, var(--bp-build) 42%, var(--line)); opacity: 0; transform: translateY(14%); transition: opacity 550ms var(--ease-out), transform 550ms var(--ease-out); }
  [data-reveal].is-in .bd__hero { transform: scaleX(1); opacity: 1; }
