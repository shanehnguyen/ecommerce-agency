  .cs-back { display: inline-block; margin-bottom: var(--space-6); font-size: var(--fs-caption); font-weight: var(--fw-body-semi); color: var(--ink-50); text-decoration: none; }
  .cs-back:hover { color: var(--ink); }

  .cs-article__h { margin-top: var(--space-3); font-size: clamp(1.875rem, 4.5vw, 2.75rem); line-height: 1.15; }
  .cs-article__dek { margin-top: var(--space-4); font-family: var(--font-serif); font-style: italic; font-size: var(--fs-lede); color: var(--ink-soft); }

  .cs-article__hero { margin-top: var(--space-8); border-radius: var(--radius-md); overflow: hidden; border: var(--rule-width) solid var(--line); aspect-ratio: 16 / 9; }
  .cs-article__hero :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  .cs-body { margin-top: var(--space-8); }
  .cs-body h2 { margin-top: var(--space-10); font-size: var(--fs-h4); }
  .cs-body p { margin-top: var(--space-4); }
  .cs-body p:first-of-type { margin-top: 0; }

  .cs-table-wrap { margin-top: var(--space-5); overflow-x: auto; border: var(--rule-width) solid var(--line); border-radius: var(--radius-sm); }
  .cs-table { width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: var(--fs-caption); }
  .cs-table th, .cs-table td { padding: var(--space-3) var(--space-4); text-align: left; border-bottom: var(--rule-width) solid var(--line); }
  .cs-table th { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-caps); font-size: var(--fs-small); color: var(--ink-50); background: var(--bg-raised); }
  .cs-table td:first-child { font-weight: var(--fw-body-semi); color: var(--ink); white-space: nowrap; }
  .cs-table tbody tr:last-child td { border-bottom: 0; }
  .cs-table tbody tr:nth-child(2n) { background: color-mix(in srgb, var(--bg-raised) 60%, transparent); }

  .cs-article__bio { margin-top: var(--space-12); padding-top: var(--space-8); border-top: var(--rule-width) solid var(--line); }
  .cs-article__bio p { font-family: var(--font-serif); font-size: var(--fs-lede); color: var(--ink); }
  .cs-article__cta { margin-top: var(--space-8); }
</style>
