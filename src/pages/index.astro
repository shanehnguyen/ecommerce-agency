---
/* Home — copy pulled from 00-MASTER-OFFER.md (the offer, the guarantees,
   the delivery SOP) rather than invented from scratch. New slots that never
   existed before still carry honest, non-fabricated placeholder marks,
   flagged inline. Light throughout, centered and airy; portfolio is the
   loudest section, but capped short. Purely-decorative sections with no
   real content (the old credibility strip, work wall, atmospheric band,
   composite-visual floating tiles) were cut — they read as unlabeled
   "weird boxes" rather than earning their place on the page. FAQ stays,
   trimmed to the 4 questions that matter, right before the final CTA.
   Signature motion: the large statement-style headings (portfolio heading,
   closing) resolve from near-invisible to full contrast on
   scroll. Respects reduced-motion. */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import FAQ from '../components/FAQ.astro';
import TheProblem from '../components/TheProblem.astro';
import TheDeal from '../components/TheDeal.astro';
import PortfolioMarquee from '../components/PortfolioMarquee.astro';
import PriceCardContent from '../components/PriceCardContent.astro';
import { site } from '../data/site.config';
import { homeFaqs } from '../data/faqs';
import { priceCards } from '../data/pricing';
import { fourteenDayLabel } from '../utils/dates';

// All 5 broad FAQ questions (each already rolls up several real objections).
const topFaqs = homeFaqs;

// "14 days from today" — computed at build so the date in the final CTA
// stays real on every deploy instead of hardcoding one that goes stale.
const fourteenLabel = fourteenDayLabel();
---
<BaseLayout
  title={`${site.brand}: Conversion-Built Shopify Stores for Consumer Brands`}
  description="Front Page Commerce builds custom Shopify stores for consumer brands. Get a free new product page for your best seller first. Live in 14 days or you don't pay."
>
  <!-- soft gradient wash behind the hero only, fading to flat bg by the fold -->
  <div class="hero-wash" aria-hidden="true"></div>

  <!-- 2. HERO -->
  <section class="hero">
    <div class="container">
      <h1 class="hero__h1"><span>Shopify stores that convert <span class="hero__h1-nb">1.5–2x</span> higher, in 14 days</span></h1>
    </div>
    <div class="container">
      <p class="hero__sub">Done for you. I rebuild your best-selling product page first — you see it before you buy.</p>
    </div>

    <!-- 3. VSL — Wistia embed (adaptive streaming: only the part a viewer
         watches is downloaded, quality adjusts to their connection).
         Autoplay / mute / controls are set in Wistia's video settings.
         The swatch style shows a blurred still until the player boots. -->
    <div class="container hero__video">
      <link rel="preconnect" href="https://fast.wistia.com" />
      <link rel="preconnect" href="https://fast.wistia.net" />
      <!-- Wistia's player is ~25 files and ~1s of phone CPU; loading it
           while the page paints delayed the headline badly. It now loads
           right after first paint (window load + idle, or the first
           scroll/tap, whichever comes first). -->
      <script is:inline>
        (function () {
          var done = false;
          function boot() {
            if (done) return; done = true;
            var a = document.createElement('script'); a.src = 'https://fast.wistia.com/player.js'; a.async = true; document.head.appendChild(a);
            var b = document.createElement('script'); b.src = 'https://fast.wistia.com/embed/cbpagze6zt.js'; b.type = 'module'; b.async = true; document.head.appendChild(b);
          }
          function soon() { if ('requestIdleCallback' in window) requestIdleCallback(boot, { timeout: 1500 }); else setTimeout(boot, 300); }
          if (document.readyState === 'complete') soon(); else window.addEventListener('load', soon, { once: true });
          ['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach(function (e) { window.addEventListener(e, boot, { once: true, passive: true }); });
        })();
      </script>
      <style is:inline>wistia-player[media-id='cbpagze6zt']:not(:defined) { background: center / contain no-repeat url('https://fast.wistia.com/embed/medias/cbpagze6zt/swatch'); display: block; filter: blur(5px); padding-top:56.25%; }</style>
      <div class="vsl">
        <wistia-player media-id="cbpagze6zt" aspect="1.7777777777777777"></wistia-player>
      </div>
    </div>

    <!-- CTA BLOCK -->
    <div class="container">
      <div class="hero__cta">
        <CtaBlock event="Hero" />
      </div>
    </div>
  </section>

  <TheProblem />

  <!-- 6. PRICING (two offers) — sits directly after the problem + portfolio
       proof: by this point the visitor has seen the promise, the guarantee,
       and real client numbers, so the offer answers the natural next
       question ("what is it and what does it cost?") before scroll-depth
       decay loses them. The process/ingredients sections follow as
       justification for anyone still on the fence. -->
  <section class="pricing" id="pricing">
    <div class="container pricing__head">
      <h2 class="pricing__heading">Fix the leaks. Then <span class="pricing__accent">scale</span>.</h2>
      <p class="pricing__sub">See the new product page for your best-selling product before you pay for the build.</p>
    </div>
    <div class="container">
      <div class="pricing__grid">
        {priceCards.map((c, i) => (
          <div class:list={['pcard', { 'pcard--featured': c.featured }]} data-reveal style={`transition-delay:${i * 90}ms`}>
            <PriceCardContent card={c} animate />
            <a class="btn btn--primary btn--pill pcard__cta" href={`${site.cta.href}?from=${encodeURIComponent(c.event)}`} data-event={c.event}><span class="btn__label">{c.cta}</span></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- the offer's spine: the 5-step sequence with the money state at each
       step — directly after the cards so "what does it cost" is answered
       by "when (and whether) you actually pay". Hidden for now (Oct 2026);
       uncomment to bring it back, the component is unchanged. -->
  {/* <TheDeal /> */}

  <PortfolioMarquee />

  <!-- FAQ (top 5 questions) -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-section__head">
        <h2 class="faq-section__heading stmt">Common Questions</h2>
      </div>
      <div class="faq-section__list"><FAQ items={topFaqs} open /></div>
      <p class="faq-section__more" aria-hidden="true">↓</p>
    </div>
  </section>

  <!-- 11. FINAL CTA (dark) — right before the footer. The page's thesis
       statement, made the loudest visual on the page: an oversized
       count-up on "14" plus an animated today-to-launch timeline. -->
  <section class="closing section--dark">
    <div class="container closing__inner">
      <h2 class="closing__h stmt">
        See your product page first. Live in <span class="closing__h-days"><span data-count-to="14">14</span> days</span>.
      </h2>
      <div class="countdown-track" data-reveal aria-hidden="true">
        <span class="countdown-track__point">
          <span class="countdown-track__dot"></span>
          <span class="mono">Today</span>
        </span>
        <span class="countdown-track__bar"><span class="countdown-track__fill"></span></span>
        <span class="countdown-track__point">
          <span class="countdown-track__dot countdown-track__dot--end"></span>
          <span class="mono" data-14day>{fourteenLabel}</span>
        </span>
      </div>
      <p>Book today and you’ll see your new product page before you buy. Your store is live in 14 days, by <span data-14day>{fourteenLabel}</span>.</p>
      <div class="closing__cta">
        <CtaBlock event="Closing" />
      </div>
      <p class="closing__sig">{site.founder}, {site.brand}</p>
    </div>
  </section>

</BaseLayout>

<script>
  /* ---- "Live by <date>" stays true after the build date ----
     fourteenDayLabel() runs at BUILD time, so a site that sits undeployed
     for a week quotes a launch date already less than 14 days out. The
     rendered value is the no-JS fallback; this recomputes it from the
     visitor's own clock on load. Same helper, so the two can never
     disagree about how the date is formatted. ---- */
  import { fourteenDayLabel } from '../utils/dates';
  (function () {
    var label = fourteenDayLabel();
    document.querySelectorAll('[data-14day]').forEach(function (el) { el.textContent = label; });
  })();
</script>

<script>
  // ---- Signature motion: statement-style headings resolve on scroll ----
  (function () {
    var stmts = Array.prototype.slice.call(document.querySelectorAll('.stmt'));
    if (!stmts.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var litAll = function () { stmts.forEach(function (s) { s.classList.add('is-lit'); }); };
    if (reduce || !('IntersectionObserver' in window)) { litAll(); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-lit'); io.unobserve(e.target); } });
    }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
    stmts.forEach(function (s) { io.observe(s); });
    // failsafe: never leave a heading stuck faint
    window.addEventListener('load', function () { setTimeout(litAll, 700); });
  })();

</script>

<style>
  /* ---------- hero load sequence (runs once on arrival, no re-trigger) ----------
     Logo (Nav.astro, self-contained) fades first, then the headline lines
     stagger up, subhead follows, CTA + the 3-step process strip stagger in
     last. Delays overlap rather than chain off full durations so the whole
     thing lands under ~1s instead of stacking to a slow crawl. */
  @keyframes hero-rise { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  /* the headline itself does NOT fade in: it's the page's largest paint
     (LCP), and an opacity-0 start made it wait for a free main thread —
     ~8s on a throttled phone. Everything below it still rises in. */
  .js .hero__sub { opacity: 0; animation: hero-rise 450ms var(--ease-out) 260ms forwards; }
  .js .hero__cta :global(.cta-block) { opacity: 0; animation: hero-rise 450ms var(--ease-out) 360ms forwards; }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(1)),
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(3)),
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(5)) {
    opacity: 0; animation: hero-rise 400ms var(--ease-out) forwards;
  }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(1)) { animation-delay: 440ms; }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(3)) { animation-delay: 520ms; }
  .js .hero__cta :global(.cta-repeat__process > span:nth-child(5)) { animation-delay: 600ms; }

  /* ---------- soft hero wash (behind hero only) ---------- */
  .hero-wash {
    position: absolute; inset: 0 0 auto 0; height: 96vh; z-index: 0; pointer-events: none;
    background:
      radial-gradient(80% 60% at 50% 12%, color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 60%),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent) 5%, var(--bg)) 0%, var(--bg) 62%);
  }


  /* ---------- 2. HERO ---------- */
  /* nav is a regular in-flow bar now (not a floating overlay), so the hero
     no longer needs to reserve space to clear it. Spacing matches the
     reference done-for-you hero: space-12 top, space-6 to the video,
     space-5 to the CTA. */
  .hero { position: relative; z-index: 1; padding-top: var(--space-12); padding-bottom: var(--space-10); text-align: center; }
  /* inherits the global h1 (uppercase Archivo display, var(--fs-display)) — only
     margin/max-width are overridden, same as the reference hero. One span,
     balance-wrapped: ~3 even lines on mobile, 2 on desktop — no nowrap,
     since "Shopify stores that convert 1.5–2x higher" is too long to pin
     to a single line at phone widths. */
  .hero__h1 { max-width: 34ch; margin-inline: auto; font-size: var(--fs-display); }
  .hero__h1 > span { display: block; text-wrap: balance; }
  /* the multiplier is the claim — never let "1.5–2x" split across lines */
  .hero__h1-nb { white-space: nowrap; }
  .hero__sub { margin: var(--space-5) auto 0; max-width: 44ch; font-family: var(--font-serif); font-style: italic; font-size: var(--fs-lede); color: var(--ink-soft);  text-wrap: balance; }
  .hero__video { margin-top: var(--space-6); }
  .hero__cta { margin-top: var(--space-5); }

  /* ---------- 3. VSL (Wistia) ---------- */
  .vsl {
    width: 100%; max-width: 50rem; margin-inline: auto; border-radius: 16px; overflow: hidden;
    background: #0f120e; box-shadow: 0 40px 80px -40px rgba(26, 24, 20, 0.5);
  }
  /* ---------- signature statement motion ---------- */
  .stmt { transition: opacity 800ms var(--ease-out), color 800ms var(--ease-out); }
  .js .stmt { opacity: 0.35; }
  .js .stmt.is-lit { opacity: 1; }

  /* ---------- mid-page CTA (after the problem/proof) ---------- */

  /* ---------- 6. PRICING (two offers — made to stand out, pricing-inspo) ---------- */
  .pricing { padding-block: clamp(2.5rem, 7vh, 5rem); }
  .pricing__head { text-align: center; margin-bottom: var(--space-12); }
  .pricing__eyebrow { display: flex; align-items: center; justify-content: center; gap: var(--space-4); color: var(--ink-50); }
  .pricing__eyebrow::before, .pricing__eyebrow::after { content: ""; width: 2.5rem; height: var(--rule-width); background: var(--line); }
  .pricing__heading { margin-top: var(--space-4); font-size: var(--fs-display); }
  .pricing__accent { color: var(--accent-deep); }
  .pricing__sub { margin-top: var(--space-4); font-size: var(--fs-lede); color: var(--ink-soft); max-width: 42ch; margin-inline: auto;  text-wrap: balance; }
  .pricing__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); max-width: 64rem; margin-inline: auto; }
  /* align-items:start so each card is only as tall as its own scope.
     Stretched to equal height, the shorter card pads itself out with dead
     space under its CTA. */
  @media (min-width: 44em) { .pricing__grid { grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: start; } }
  /* .pcard* card styles (including the value stack) are shared in
     components.css — rendered via PriceCardContent.astro on both the
     homepage and /apply so the two never drift apart. Only the pricing
     SECTION layout + the homepage-only CTA link are styled here. */
  @media (max-width: 40em) {
    /* phones: one fixed section rhythm (40px top + bottom = 80px between
       sections) instead of the vh-based clamps, which drifted with phone
       height and differed section to section */
    .hero { padding-bottom: var(--space-10); }
    .pricing, .faq-section { padding-block: var(--space-10); }
    .closing { padding-block: var(--space-12); }
    .pricing__head { margin-bottom: var(--space-6); }
    .pricing__sub { font-size: var(--fs-body); }
    .pricing__grid { gap: var(--space-4); }
    .pcard__cta { padding: var(--space-3) var(--space-6); font-size: var(--fs-body); }
  }

  /* ---------- FAQ ---------- */
  .faq-section { padding-block: clamp(2.5rem, 7vh, 5rem); }
  .faq-section__head { text-align: center; }
  .faq-section__heading { margin-top: var(--space-4); margin-inline: auto; font-size: var(--fs-display); }
  .faq-section__list { margin-top: var(--space-8); }
  .faq-section__more { margin-top: var(--space-8); text-align: center; font-size: var(--fs-subhead); color: var(--ink-50); animation: faq-more-bounce 1800ms ease-in-out infinite; }
  @keyframes faq-more-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .faq-section__more { animation: none; } }

  /* ---------- 11. FINAL CTA (dark) ---------- */
  .closing { padding-block: clamp(3rem, 10vh, 6rem); }
  .closing__inner { text-align: center; }
  .closing__h { font-size: var(--fs-display); max-width: 26ch; margin-inline: auto; }

  /* the page's thesis statement, made the loudest element on the page:
     "14 days" runs bigger than the rest of the headline, in brass, with a
     slow persistent glow; a below timeline visually marks today → launch */
  .closing__h-days {
    display: inline-block; line-height: 0.9; color: var(--accent-strong);
    animation: closing-glow 3s var(--ease-io) infinite;
  }
  .closing__h-days > span:first-child { font-variant-numeric: tabular-nums; }
  @keyframes closing-glow {
    0%, 100% { text-shadow: 0 0 18px color-mix(in srgb, var(--accent-strong) 0%, transparent); }
    50%      { text-shadow: 0 0 18px color-mix(in srgb, var(--accent-strong) 55%, transparent); }
  }

  .countdown-track { margin: var(--space-6) auto 0; max-width: 26rem; display: flex; align-items: flex-start; gap: var(--space-3); }
  .countdown-track__point { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); flex-shrink: 0; min-width: 5.5rem; }
  .countdown-track__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--dark-line); box-shadow: 0 0 0 4px color-mix(in srgb, var(--dark-ink) 8%, transparent); }
  .countdown-track__dot--end { background: var(--accent-strong); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-strong) 22%, transparent); }
  .countdown-track__point .mono { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--dark-soft); white-space: nowrap; }
  .countdown-track__bar { position: relative; flex: 1; height: 2px; margin-top: 4px; background: var(--dark-line); border-radius: 2px; overflow: hidden; }
  .countdown-track__fill {
    position: absolute; inset: 0; background: var(--accent-strong); border-radius: 2px;
    transform-origin: left; transform: scaleX(0);
    transition: transform 1100ms var(--ease-out) 250ms;
  }
  .js [data-reveal].is-in .countdown-track__fill { transform: scaleX(1); }

  .closing__inner p { text-wrap: balance; margin-top: var(--space-4); font-family: var(--font-serif); font-size: var(--fs-lede); line-height: 1.65; color: var(--dark-soft); max-width: 56ch; margin-inline: auto; }
  .closing__cta { margin-top: var(--space-8); }
  .closing__sig { margin-top: var(--space-8) !important; font-family: var(--font-display) !important; font-size: var(--fs-subhead) !important; color: var(--dark-ink) !important; }



</style>
