  }
  [data-reveal].is-in .bd__frame::after { animation-play-state: running; }
  @keyframes bd-shimmer { 0%, 15% { transform: translateX(-140%); } 65%, 100% { transform: translateX(140%); } }

  /* ---- step 3: optimize — a bar chart and trend line keep redrawing
