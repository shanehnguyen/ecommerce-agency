  .op__chart { position: absolute; inset: 12% 10% 10%; display: flex; align-items: flex-end; gap: 9%; }
  .op__bar { flex: 1; border-radius: 4px 4px 0 0; background: var(--bg-raised); border: var(--rule-width) solid var(--line); border-bottom: 0; transform-origin: bottom; animation: op-grow 4.2s var(--ease-out) infinite; animation-play-state: paused; }
