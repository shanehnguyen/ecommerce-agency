---
/* /after-booking — where a booked lead lands: one short video from Shane on
   the one thing to do before the call, then the full FAQ (src/data/faqs.ts,
   shared with /faq). noindex, and kept out of the sitemap. */
import BareLayout from '../layouts/BareLayout.astro';
import FAQ from '../components/FAQ.astro';
import { callFaqGroups } from '../data/faqs';
import { site } from '../data/site.config';
---
<BareLayout
  title="One last thing before our call"
  description="You're booked. Watch this short video before we talk."
  noindex={true}
>
  <section class="section ab">
    <div class="container container--narrow">
      <h1 class="ab__h1">One last thing to do before our call...</h1>

      <div class="ab__video">
        <video
          class="ab__media"
          controls playsinline preload="metadata"
          disablepictureinpicture controlslist="nodownload noplaybackrate"
          poster="/video/after-booking-poster.jpg"
          aria-label="A short video from Shane before your call"
        >
          <source src="/video/after-booking.mp4" type="video/mp4" />
        </video>
      </div>

      <!-- The video's ask in plain text, for anyone who watches muted or not at all. -->
      <p class="ab__todo">
        <strong>Check your email and accept the calendar invite.</strong>
        Wrong time? <a href={`sms:+1${site.phone.replace(/\D/g, '')}`}>Text me: {site.phone}</a>
      </p>

      <div class="ab__faq">
        <h2 class="ab__faq-h">Frequently Asked Questions</h2>
        <div class="ab__faq-list"><FAQ groups={callFaqGroups} headingTag="h3" /></div>
      </div>

      <div class="ab__more">
        <p class="ab__more-q">Still have questions?</p>
        <a class="btn btn--ghost" href="/faq">Read our full FAQ <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BareLayout>

<style>
  .ab { padding-block: clamp(2.5rem, 7vh, 4.5rem) clamp(3rem, 8vh, 5rem); text-align: center; }
  .ab__h1 { margin-inline: auto; max-width: 20ch; font-size: clamp(2rem, 5vw, 3.25rem); }
  .ab__video {
    position: relative; width: 100%; max-width: 27rem; aspect-ratio: 3 / 4;
    margin: var(--space-8) auto 0; border-radius: 16px; overflow: hidden;
    background: #0f120e; box-shadow: 0 40px 80px -40px rgba(26, 24, 20, 0.5);
  }
  .ab__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ab__todo { margin: var(--space-6) auto 0; max-width: 27rem; font-size: var(--fs-lede); line-height: 1.5; color: var(--ink-70); }
  .ab__todo strong { display: block; color: var(--ink); }
  .ab__todo a { color: var(--ink); font-weight: var(--fw-body-semi); white-space: nowrap; }
  .ab__faq { margin-top: clamp(3rem, 8vh, 5rem); text-align: left; }
  .ab__faq-h { text-align: center; font-size: clamp(1.5rem, 4vw, 2.5rem); }
  .ab__faq-list { margin-top: var(--space-6); }
  .ab__more { margin-top: var(--space-10); display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
  .ab__more-q { font-family: var(--font-display); font-weight: var(--fw-display); font-size: var(--fs-h4); color: var(--ink); }
</style>
