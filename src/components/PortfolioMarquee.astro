---
/* PortfolioMarquee — mobile keeps a static 2-column grid; desktop
   (>=60em) switches to an actual auto-scrolling marquee instead (the
   full-bleed 2-col grid read as oversized/heavy at desktop width). The
   card list renders twice back-to-back for the desktop marquee, as direct
   siblings in one flex row — a translateX(-50%) loop then moves by
   exactly half the track's total width, landing precisely on the start of
   the second (duplicate) copy, same technique as the hero's wordmark
   marquee elsewhere on this page. The second copy is aria-hidden
   (decorative repeat, not new content) and skips the scroll-reveal
   stagger since it's never the first thing on screen — see PortfolioTile.
*/
import PortfolioTile from './PortfolioTile.astro';
import caseFurniture from '../assets/portfolio/case-furniture.png';
import junglee from '../assets/portfolio/Junglee.png';
import kincMarket from '../assets/portfolio/kinc-markett.png';
import lynhsDrinks from '../assets/portfolio/lynhs-drink-portfolio.png';
import yunHaiShop from '../assets/portfolio/Yun-Hai-Shop.png';
import pkCabinets from '../assets/portfolio/pk-cabinet-portfolio.png';

// fromTo/months aren't shown in this full-bleed layout (name + headline
// number only, per the current design), but stay on the record here since
// they're real client figures/tenure, documented in case a future layout
// wants them back — see the git history of this file for their prior
// on-card treatment.
type Card = {
  name: string; image: ImageMetadata; zoom?: number; pos?: number; months: number;
  label: string; countPrefix?: string; countTo: string; suffix?: string; fromTo: string;
};

// pos = vertical object-position (%) — how far down into the source photo the
// crop starts. Default (set in CSS) is 45%; Lynh's Drinks and PK Cabinets need
// a much deeper crop to clear their taller hero photography.
const cards: Card[] = [
  { name: "Lynh's Drinks", image: lynhsDrinks, months: 4, pos: 80, label: 'Conversion rate', countPrefix: '+', countTo: '183', suffix: '%', fromTo: '1.2% → 3.4%' },
  { name: 'Case Furniture', image: caseFurniture, months: 5, label: 'Conversion rate', countPrefix: '+', countTo: '116', suffix: '%', fromTo: '0.9% → 1.9%' },
  { name: 'Junglee Craft Cocktails', image: junglee, months: 2, label: 'Conversion rate', countPrefix: '+', countTo: '107', suffix: '%', fromTo: '2.0% → 4.2%' },
  { name: "Kim'C Market", image: kincMarket, months: 3, label: 'Conversion rate', countPrefix: '+', countTo: '89', suffix: '%', fromTo: '1.3% → 2.47%' },
  { name: 'Yun Hai Shop', image: yunHaiShop, months: 3, label: 'Avg. order value', countPrefix: '$', countTo: '137', fromTo: '$59 → $137' },
  { name: 'PK Cabinets', image: pkCabinets, months: 4, zoom: 1.2, pos: 80, label: 'Avg. order value', countPrefix: '$', countTo: '5556', fromTo: '$2,081 → $5,556' },
];
---
<!-- mobile (<60em): static 2-column grid -->
<div class="pf-list">
  {cards.map((c) => <PortfolioTile card={c} />)}
</div>

<!-- desktop (>=60em): auto-scrolling marquee -->
<div class="pf-marquee">
  <div class="pf-marquee__track">
    {cards.map((c) => <PortfolioTile card={c} />)}
    {cards.map((c) => <PortfolioTile card={c} duplicate />)}
  </div>
</div>

<style>
  /* ---------- mobile: 2-column grid, flat and edge-to-edge (no gap, no
     radius) — reads as one continuous sheet of screenshots, not spaced-out
     cards ---------- */
  .pf-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; max-width: 40rem; margin-inline: auto; }
  .pf-list :global(.pf-tile) { border-radius: 0; border: 0; }
  .pf-marquee { display: none; }

  @media (min-width: 60em) {
    .pf-list { display: none; }
    .pf-marquee { display: block; overflow: hidden; }
    .pf-marquee__track { display: flex; gap: var(--space-5); width: max-content; }

    @media (prefers-reduced-motion: no-preference) {
      .pf-marquee__track { animation: pf-scroll 34s linear infinite; }
      .pf-marquee:hover .pf-marquee__track,
      .pf-marquee:focus-within .pf-marquee__track { animation-play-state: paused; }
    }
    /* the track holds 2 identical copies of the card list back to back, so
       -50% (half the track's own width = exactly one copy) is a seamless loop */
    @keyframes pf-scroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    /* reduced motion: no auto-scroll, but the content is still all there —
       let people scroll it manually instead of losing the second half. */
    @media (prefers-reduced-motion: reduce) {
      .pf-marquee { overflow-x: auto; }
    }

    /* fixed, moderate card size for the marquee — the full-bleed grid
       tiles read as oversized at desktop width */
    .pf-marquee :global(.pf-tile) { width: 300px; flex: none; }
  }
</style>
