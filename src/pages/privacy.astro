---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.config';
---
<BaseLayout title="Privacy" description={`How ${site.brand} handles the information you share.`} noindex={true}>
  <section class="section legal">
    <div class="container container--prose">
      <h1>Privacy</h1>
      <p class="legal__date mono">Last updated September 2026</p>
      <!-- LEGAL REVIEW REQUIRED before launch. Plain-language draft only. -->
      <p>
        This site is operated by {site.legalName} (“{site.brand},” “we”).
        {site.brand} collects only what you give us: the answers and contact details you enter in the
        application and booking forms. We use them to review your application, follow up about the work,
        and improve the site.
      </p>
      <h2>What we collect</h2>
      <ul>
        <li>Your name, email, phone, store details, and the answers you give when you apply or book a call.</li>
        <li>Standard analytics (page views, events) via Meta Pixel, Microsoft Clarity, and, optionally, Google Analytics.</li>
      </ul>
      <h2>What we don’t do</h2>
      <p>We don’t sell your information. We don’t run a 14-email nurture machine. You can unsubscribe anytime.</p>
      <h2 id="sms">Text messages (SMS)</h2>
      <p>
        If you check the SMS consent box on our application form, {site.brand} will text the phone number you
        provided about your application, call reminders, and project updates. Message frequency varies.
        Message and data rates may apply. Consent to receive texts is not a condition of purchase.
      </p>
      <p>
        Reply <strong>STOP</strong> to any message to opt out, and you’ll receive one final confirmation text.
        Reply <strong>HELP</strong> for help, or contact us at <a href={`mailto:${site.email}`}>{site.email}</a>
        or {site.phone}.
      </p>
      <p>
        We keep a record of your consent (the date, time, and wording you agreed to). No mobile information will be
        shared with third parties or affiliates for marketing or promotional purposes. Text messaging originator
        opt-in data and consent will not be shared with any third parties.
      </p>
      <h2>Contact</h2>
      <p>
        Questions about your data: {site.legalName}<br />
        <a href={`mailto:${site.email}`}>{site.email}</a> · {site.phone}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal h1 { font-family: var(--font-display); }
  .legal__date { color: var(--ink-50); font-size: var(--fs-caption); margin-block: var(--space-2) var(--space-6); }
  .legal h2 { font-family: var(--font-display); text-transform: none; font-size: var(--fs-h3); margin-top: var(--space-8); }
  .legal p, .legal li { color: var(--ink-70); margin-top: var(--space-3); line-height: 1.6; }
  .legal ul { padding-left: var(--space-6); }
</style>
