  .pl-flabel { font-size: var(--fs-body-sm, var(--fs-caption)); color: var(--ink-70); }
  .pl-fnum { font-family: var(--font-mono); font-size: var(--fs-body); font-weight: var(--fw-body-semi); }
  .pl-fbar { height: 12px; background: var(--line); border-radius: 999px; overflow: hidden; }
  .pl-ffill { display: block; height: 100%; border-radius: 999px; transition: width 400ms cubic-bezier(.2,.7,.2,1); }
  .pl-fdrop { font-size: var(--fs-caption); color: var(--ink-50); font-family: var(--font-mono); min-height: 1em; }

  /* VSL retention */
  .pl-vsl__stats { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: var(--space-5); font-family: var(--font-mono); font-size: var(--fs-body-sm, var(--fs-caption)); color: var(--ink-70); }
  .pl-vsl__stats b { display: inline-block; margin-left: 6px; color: var(--ink); font-weight: var(--fw-body-semi); }
  .pl-vsl__svg { margin-top: var(--space-4); width: 100%; height: 160px; display: block; }
  .pl-vsl__area { fill: color-mix(in srgb, var(--accent) 18%, transparent); stroke: none; }
  .pl-vsl__line { stroke: var(--accent-deep, var(--accent)); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .pl-vsl__axis { display: flex; justify-content: space-between; margin-top: var(--space-2); font-size: var(--fs-caption); font-family: var(--font-mono); color: var(--ink-50); }

  .pl-tone--cool { background: #6b8cae; }
  .pl-tone--mid  { background: #A78B4F; }
  .pl-tone--warm { background: #C9803E; }
  .pl-tone--good { background: #3F7F4F; }

  /* by-CTA table */
  .pl-src { width: 100%; margin-top: var(--space-4); border-collapse: collapse; font-family: var(--font-mono); font-size: var(--fs-body-sm, var(--fs-caption)); }
  .pl-src th, .pl-src td { text-align: right; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line); }
  .pl-src th:first-child, .pl-src td:first-child { text-align: left; }
  .pl-src thead th { font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-50); font-weight: var(--fw-body-semi); }
