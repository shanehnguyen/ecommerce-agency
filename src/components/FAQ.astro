---
/* FAQ — CSS-only details/summary accordions + FAQPage schema.org markup.
   Voice-forward; doubles as on-page SEO (spec §5 / §6). */
import type { Faq, FaqBlock, FaqBullet } from '../data/faqs';
interface Props { items: Faq[]; }
const { items } = Astro.props;

// Inline markup → HTML: escape first, then **bold** and [text](/path).
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const inline = (s: string) => esc(s)
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');
const bulletHtml = (b: FaqBullet): string => typeof b === 'string'
  ? `<li>${inline(b)}</li>`
  : `<li>${inline(b.text)}<ul>${b.list.map((x) => `<li>${inline(x)}</li>`).join('')}</ul></li>`;
const blockHtml = (b: FaqBlock) => typeof b === 'string'
  ? `<p>${inline(b)}</p>`
  : `<ul>${b.list.map(bulletHtml).join('')}</ul>`;
const answerHtml = (a: Faq['a']) => (Array.isArray(a) ? a : [a]).map(blockHtml).join('');

// Plain text for the schema: markup stripped, list items joined.
const plain = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '$1').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const bulletText = (b: FaqBullet): string => typeof b === 'string' ? plain(b) : [plain(b.text), ...b.list.map(plain)].join(' ');
const answerText = (a: Faq['a']) => (Array.isArray(a) ? a : [a])
  .map((b) => typeof b === 'string' ? plain(b) : b.list.map(bulletText).join(' ')).join(' ');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: answerText(f.a) },
  })),
};
---
<div class="faq">
  {items.map((f, i) => (
    <details class="faq__item" data-reveal style={`transition-delay:${i * 70}ms`}>
      <summary class="faq__q">
        <span>{f.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__a-wrap">
        <div class="faq__a" set:html={answerHtml(f.a)} />
      </div>
    </details>
  ))}
</div>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
<script>
  // Animate open/close by transitioning a measured pixel height (scrollHeight),
  // not the CSS-only grid-template-rows trick — that trick relies on browsers
  // interpolating `fr` track sizes, which turned out not to animate reliably
  // here (the property stuck at its starting value instead of transitioning
  // or even snapping to the end value). Height transitions are bulletproof.
  // JS drives both directions; a plain [open] CSS fallback below covers the
  // zero-JS case (instant, unanimated, but correct).
  document.querySelectorAll('.faq__item').forEach((item) => {
    const summary = item.querySelector(':scope > summary');
    const wrap = item.querySelector(':scope > .faq__a-wrap');
    if (!summary || !wrap) return;
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      if (item.classList.contains('is-animating')) return;
      item.classList.add('is-animating');
      const onEnd = (ev) => {
        if (ev.target !== wrap || ev.propertyName !== 'height') return;
        wrap.removeEventListener('transitionend', onEnd);
        item.classList.remove('is-animating');
        if (item.open) wrap.style.height = ''; // let it size naturally once fully open
      };
      wrap.addEventListener('transitionend', onEnd);
      if (item.open) {
        // closing: measure the current rendered height as the transition's
        // start point, then collapse to 0
        wrap.style.height = wrap.scrollHeight + 'px';
        void wrap.offsetHeight;
        requestAnimationFrame(() => { wrap.style.height = '0px'; });
        // wait for the collapse to finish before actually closing <details>,
        // otherwise the browser hides the content instantly mid-animation
        const onCollapseEnd = (ev) => {
          if (ev.target !== wrap || ev.propertyName !== 'height') return;
          wrap.removeEventListener('transitionend', onCollapseEnd);
          item.open = false;
        };
        wrap.addEventListener('transitionend', onCollapseEnd);
      } else {
        item.open = true;
        wrap.style.height = '0px';
        void wrap.offsetHeight;
        requestAnimationFrame(() => { wrap.style.height = wrap.scrollHeight + 'px'; });
      }
    });
  });
</script>

<style>
  .faq { border-top: var(--rule-width) solid var(--rule); }
  .faq__item { border-bottom: var(--rule-width) solid var(--rule); }
  .faq__q {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-5) 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); text-transform: none; font-size: var(--fs-h4);
    color: var(--ink); font-weight: var(--fw-display);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; width: 16px; height: 16px; flex-shrink: 0; transition: transform 200ms var(--ease-out); }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; background: var(--brass); }
  .faq__icon::before { top: 7px; left: 0; width: 16px; height: 2px; }
  .faq__icon::after { left: 7px; top: 0; width: 2px; height: 16px; }
  /* rotating the whole "+" 45° reads as "×" — no separate bar-hide needed */
  .faq__item[open] .faq__icon { transform: rotate(45deg); }

  /* JS drives the animated height via inline style (wins the cascade while
     it's active); this covers the zero-JS fallback: instant, unanimated,
     but still correct open/closed state. */
  .faq__a-wrap { height: 0; overflow: hidden; transition: height 300ms var(--ease-out); }
  .faq__item[open] .faq__a-wrap { height: auto; }
  .faq__a { padding-bottom: var(--space-5); max-width: 65ch; }
  /* answer HTML comes in via set:html, so these need :global to reach it */
  .faq__a :global(p), .faq__a :global(li) { color: var(--ink-70); line-height: 1.6; }
  .faq__a :global(* + p), .faq__a :global(* + ul) { margin-top: var(--space-3); }
  .faq__a :global(ul) { padding-left: var(--space-5); list-style: disc; }
  .faq__a :global(ul ul) { margin-top: var(--space-2); list-style: circle; }
  .faq__a :global(li + li) { margin-top: var(--space-1); }
  .faq__a :global(strong) { color: var(--ink); font-weight: var(--fw-body-semi); }
  .faq__a :global(a) { color: var(--ink); }
</style>
