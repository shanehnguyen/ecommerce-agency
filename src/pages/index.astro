  .closing__h { font-size: clamp(2rem, 5.5vw, 4rem); max-width: 26ch; margin-inline: auto; }

  /* the page's thesis statement, made the loudest element on the page:
     "14 days" runs bigger than the rest of the headline, in brass, with a
     slow persistent glow; a below timeline visually marks today → launch */
  .closing__h-days {
    display: inline-block; font-size: 1.5em; line-height: 0.9; color: var(--accent-strong);
    animation: closing-glow 3s var(--ease-io) infinite;
  }
  .closing__h-days > span:first-child { font-variant-numeric: tabular-nums; }
  @keyframes closing-glow {
    0%, 100% { text-shadow: 0 0 18px color-mix(in srgb, var(--accent-strong) 0%, transparent); }
    50%      { text-shadow: 0 0 18px color-mix(in srgb, var(--accent-strong) 55%, transparent); }
  }

  .countdown-track { margin: var(--space-6) auto 0; max-width: 26rem; display: flex; align-items: flex-start; gap: var(--space-3); }
  .countdown-track__point { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); flex-shrink: 0; width: 5.5rem; }
  .countdown-track__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--dark-line); box-shadow: 0 0 0 4px color-mix(in srgb, var(--dark-ink) 8%, transparent); }
  .countdown-track__dot--end { background: var(--accent-strong); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-strong) 22%, transparent); }
  .countdown-track__point .mono { font-size: var(--fs-small); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--dark-soft); white-space: nowrap; }
  .countdown-track__bar { position: relative; flex: 1; height: 2px; margin-top: 4px; background: var(--dark-line); border-radius: 2px; overflow: hidden; }
  .countdown-track__fill {
    position: absolute; inset: 0; background: var(--accent-strong); border-radius: 2px;
