---
/* WhatGoesIn — "03. What Goes In": the 9-ingredient masonry grid that
   replaced the old 3-step Blueprint. Sits ahead of Our Timeline per the
   page's sales order: hero, problem, proof, ingredients, timeline, price,
   FAQ, CTA. Copy is the literal offer breakdown
   (00-MASTER-OFFER.md), not invented. Every badge is either a stated
   third-party research figure (marked with the ↑ prefix) or a plain
   editorial line — never a fabricated stat.
   Visual language mirrors public/ingredients-inspo: oversized bold titles,
   a real inline icon/mock per ingredient (not just a text card), a stat
   tile, and a scrolling "+ feature" ticker — built entirely in this
   project's own cream/ink/brass tokens, not the reference's colors. Cards
   are static (no accordion): every ingredient's full copy is short enough
   to show at a glance, same as the reference. */

const ingredients = [
  {
    n: '01', title: 'Category Teardown', mock: 'teardown',
    paragraphs: ['We pull apart the best-converting stores in your category before writing a line of code.'],
    badge: 'Starts day one. Nothing gets designed before this is done.', arrow: false,
  },
  {
    n: '02', title: 'Offer Architecture', mock: 'bundle',
    paragraphs: ['Bundles and tiers, priced against your real margin — not just conversion rate.'],
    badge: 'The only ingredient here that can lose you money if done wrong', arrow: false,
  },
  {
    n: '03', title: 'Conversion Copywriting', mock: 'checklist',
    paragraphs: ['Every headline, bullet, and button written from scratch. No lorem, no theme defaults.'],
    badge: 'Written after the teardown, not before', arrow: false,
  },
  {
    n: '04', title: 'Social Proof, Placed', mock: 'reviews',
    paragraphs: ['Reviews placed next to the doubt they answer, not buried in a widget.'],
    badge: 'Same reviews, different position, different result', arrow: false,
  },
  {
    n: '05', title: 'Imagery and Video System', mock: 'gallery',
    paragraphs: ["A full gallery and video system, sized and lazy-loaded so it never slows you down."],
    badge: 'Cold traffic needs to see the product used before it trusts the price', arrow: false,
  },
  {
    n: '06', title: 'Trust and Shipping Signals', mock: 'trust',
    paragraphs: ['Delivery dates, stock status, and secure checkout, shown right on the product page.'],
    badge: 'Baymard: unexpected extra costs are the #1 abandonment reason', arrow: true,
  },
  {
    n: '07', title: 'Mobile First at 390px', mock: 'phone',
    paragraphs: ["Designed on a phone before it's ever seen on a monitor."],
    badge: 'Mobile carries 65 to 85% of sessions and converts at about half the desktop rate', arrow: true,
  },
  {
    n: '08', title: 'Speed Budget', mock: 'speed',
    paragraphs: ['Every element earns its weight. If it slows the page, it gets cut.'],
    badge: 'Google / Deloitte: 0.1s faster on mobile = +8.4% conversions, +9.2% AOV', arrow: true,
  },
  {
    n: '09', title: 'Cart and Checkout', mock: 'cart',
    paragraphs: ['Cart, checkout, and upsells — the last three clicks that carry the most lost revenue.'],
    badge: "70.22% of carts are abandoned. That number hasn't moved in a decade.", arrow: true,
  },
];

// "+ feature" ticker — decomposed straight from the CTA-strip copy, not
// invented; "and 30 more" lives on the stat tile instead so it isn't said twice.
const tickerTags = ['Email & SMS capture', 'Variant & stock logic', 'Back-in-stock alerts', 'SEO structure'];
---
<section class="wgi" id="what-goes-in">
  <div class="container wgi__head">
    <p class="eyebrow-num mono eyebrow-num--center">03. What Goes In</p>
    <h2 class="wgi__heading">Our ingredients. Your <span class="wgi__accent">result</span>.</h2>
    <p class="wgi__sub">Every element used to turn your website into a sales machine.</p>
  </div>

  <div class="container">
    <div class="wgi__grid">
      {ingredients.map((c, i) => (
        <article class="wgi-card" data-reveal style={`transition-delay:${i * 60}ms`}>
          <p class="wgi-card__eyebrow mono"><span class="wgi-card__dot" aria-hidden="true"></span>Ingredient {c.n}</p>
          <h3 class="wgi-card__title">{c.title}</h3>

          {c.mock === 'teardown' && (
            <div class="wgi-mock wgi-mock--teardown" aria-hidden="true">
              <span class="wgi-mock__pane wgi-mock__pane--1"><span></span><span></span></span>
              <span class="wgi-mock__pane wgi-mock__pane--2"><span></span><span></span></span>
              <span class="wgi-mock__pane wgi-mock__pane--3"><span></span><span></span></span>
              <span class="wgi-mock__glass">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </span>
            </div>
          )}
          {c.mock === 'bundle' && (
            <div class="wgi-mock wgi-mock--bundle" aria-hidden="true">
              <span class="wgi-mock__row"><span class="wgi-mock__radio"></span><span class="wgi-mock__row-bar"></span></span>
              <span class="wgi-mock__row"><span class="wgi-mock__radio"></span><span class="wgi-mock__row-bar"></span></span>
              <span class="wgi-mock__row wgi-mock__row--hi"><span class="wgi-mock__radio wgi-mock__radio--on"></span><span class="wgi-mock__row-bar"></span><span class="wgi-mock__row-tag mono">Best</span></span>
            </div>
          )}
          {c.mock === 'checklist' && (
            <div class="wgi-mock wgi-mock--checklist" aria-hidden="true">
              <span class="wgi-mock__check is-on">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="wgi-mock__check-bar"></span>
              </span>
              <span class="wgi-mock__check is-on">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="wgi-mock__check-bar"></span>
              </span>
              <span class="wgi-mock__check">
                <span class="wgi-mock__check-ring"></span>
                <span class="wgi-mock__check-bar wgi-mock__check-bar--off"></span>
              </span>
            </div>
          )}
          {c.mock === 'reviews' && (
            <div class="wgi-mock wgi-mock--reviews" aria-hidden="true">
              <span class="wgi-mock__top">
                <span class="wgi-mock__stars">★★★★★</span>
                <span class="wgi-mock__count mono">128</span>
                <span class="wgi-mock__sizes"><span>S</span><span class="is-on">M</span><span>L</span></span>
              </span>
              <span class="wgi-mock__meter"><span class="wgi-mock__meter-fill"></span></span>
            </div>
          )}
          {c.mock === 'gallery' && (
            <div class="wgi-mock wgi-mock--gallery" aria-hidden="true">
              <span class="wgi-mock__thumb"></span>
              <span class="wgi-mock__thumb wgi-mock__thumb--play">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
              </span>
              <span class="wgi-mock__thumb"></span>
              <span class="wgi-mock__thumb"></span>
            </div>
          )}
          {c.mock === 'trust' && (
            <div class="wgi-mock wgi-mock--trust" aria-hidden="true">
              <span class="wgi-mock__chip">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="13" height="9"></rect><path d="M14 10h4l3 3v3h-7z"></path><circle cx="6" cy="18" r="1.6"></circle><circle cx="17.5" cy="18" r="1.6"></circle></svg>
                Delivery Tue
              </span>
              <span class="wgi-mock__chip">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8"></path></svg>
                12 in stock
              </span>
              <span class="wgi-mock__chip wgi-mock__chip--accent">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
                Secure checkout
              </span>
            </div>
          )}
          {c.mock === 'phone' && (
            <div class="wgi-mock wgi-mock--phone" aria-hidden="true">
              <span class="wgi-mock__phone">
                <span class="wgi-mock__phone-row"></span>
                <span class="wgi-mock__phone-row wgi-mock__phone-row--sm"></span>
                <span class="wgi-mock__phone-cta"></span>
              </span>
            </div>
          )}
          {c.mock === 'speed' && (
            <div class="wgi-mock wgi-mock--speed" aria-hidden="true">
              <span class="wgi-mock__bar-col"><span class="wgi-mock__bar wgi-mock__bar--slow"></span><span class="wgi-mock__bar-label mono">Before</span></span>
              <span class="wgi-mock__bar-col"><span class="wgi-mock__bar wgi-mock__bar--fast"></span><span class="wgi-mock__bar-label mono">After</span></span>
            </div>
          )}
          {c.mock === 'cart' && (
            <div class="wgi-mock wgi-mock--cart" aria-hidden="true">
              <span class="wgi-mock__line"></span>
              <span class="wgi-mock__line wgi-mock__line--sm"></span>
              <span class="wgi-mock__pay">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
                Pay
              </span>
            </div>
          )}
          <div class="wgi-card__body">
            {c.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <p class="wgi-card__badge mono">{c.arrow && <span aria-hidden="true">↑ </span>}{c.badge}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="wgi__stat" data-reveal>
      <p class="wgi__stat-num mono"><span data-count-to="50">50</span>+</p>
      <p class="wgi__stat-label">and much more</p>
      <p class="wgi__stat-caption">Tested ingredients. Guaranteed to work.</p>
    </div>
  </div>

  <!-- scrolling ticker — duplicated many times over so the loop point is
       always well past the widest realistic viewport (a short 4-tag set
       repeated only twice can visibly run out on ultra-wide screens) -->
  <div class="wgi-ticker" aria-hidden="true">
    <div class="wgi-ticker__track">
      {Array.from({ length: 6 }).map(() => tickerTags.map((t) => <span class="wgi-ticker__tag mono"><span class="wgi-ticker__plus">+</span>{t}</span>))}
      {Array.from({ length: 6 }).map(() => tickerTags.map((t) => <span class="wgi-ticker__tag mono"><span class="wgi-ticker__plus">+</span>{t}</span>))}
    </div>
  </div>
</section>

<style>
  .wgi { --wgi-radius: 14px; padding-block: clamp(2.5rem, 7vh, 5rem); }
  .wgi__head { text-align: center; }
  .wgi__heading { margin-top: var(--space-4); margin-inline: auto; max-width: 24ch; font-size: clamp(2rem, 5vw, 3.25rem); }
  .wgi__accent { color: var(--accent-deep); }
  .wgi__sub { margin: var(--space-4) auto 0; max-width: 48ch; font-family: var(--font-serif); font-style: italic; font-size: var(--fs-lede); line-height: 1.6; color: var(--ink-soft); }

  /* ---------- masonry: CSS multi-column (no JS layout, staggers itself
     naturally since column heights vary with each card's content). Single
     column on mobile (2 columns made the already-short copy feel cramped);
     the section stays short instead via the compact mobile card styles
     below — smaller padding/type, not more columns. ---------- */
  .wgi__grid { margin-top: var(--space-8); columns: 1; column-gap: var(--space-3); }
  @media (min-width: 44em) { .wgi__grid { columns: 2; column-gap: var(--space-6); margin-top: var(--space-10); } }
  @media (min-width: 56em) { .wgi__grid { columns: 3; } }

  .wgi-card {
    break-inside: avoid; margin-bottom: var(--space-3);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-raised));
    border: var(--rule-width) solid var(--line);
    border-radius: var(--wgi-radius);
    box-shadow: 0 14px 30px -22px rgba(26, 24, 20, 0.3);
    padding: var(--space-6);
    transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
    /* below-fold cards skip layout/paint work until they're near the viewport */
    content-visibility: auto;
    contain-intrinsic-size: 420px;
  }
  .wgi-card:hover { transform: translateY(-2px); border-color: var(--ink-50); }

  .wgi-card__eyebrow { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--fs-small); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--ink-50); }
  .wgi-card__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
  .wgi-card__title { margin-top: var(--space-3); font-size: clamp(1.5rem, 1.1vw + 1.2rem, 2rem); }
  .wgi-card__body { margin-top: var(--space-4); }
  .wgi-card__body p { font-size: var(--fs-body); line-height: 1.5; color: var(--ink-soft); }
  .wgi-card__body p + p { margin-top: var(--space-3); }
  .wgi-card__badge {
    display: inline-flex; align-items: center; gap: 0.4em;
    margin-top: var(--space-5);
    padding: 0.4em 0.85em; border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    font-size: var(--fs-small); color: var(--ink-soft);
  }

  /* ---------- inline mocks (decorative, aria-hidden, no images) ---------- */
  .wgi-mock { display: flex; align-items: flex-end; gap: var(--space-2); width: 100%; margin-top: var(--space-4); height: 3.5rem; }

  /* aspect-ratio (not a fixed height) because the panes inside are sized off
     a % of THIS box's own width — a fixed rem height fit at one card width
     (e.g. desktop 3-col) and clipped into the copy below at any narrower
     width (mobile single-col, tablet 2-col), since the panes scale with
     width but the box didn't. */
  /* height: auto is required here — .wgi-mock (above) sets an explicit
     height, and an explicit height always wins over aspect-ratio, so
     without this override the aspect-ratio below is silently ignored and
     the panes overflow into the copy underneath. Smaller pane % than the
     other mocks on purpose ("shorter" per feedback — a bit of overlap fan
     reads fine even compact). */
  .wgi-mock--teardown { position: relative; height: auto; aspect-ratio: 10 / 3; margin-bottom: var(--space-3); }
  .wgi-mock__pane { position: absolute; top: 0; width: 32%; aspect-ratio: 4 / 3; padding: 10%; display: flex; flex-direction: column; gap: 14%; border-radius: 6px; background: var(--bg); border: var(--rule-width) solid var(--line); }
  .wgi-mock__pane span { display: block; height: 12%; border-radius: 2px; background: var(--line); }
  .wgi-mock__pane span:first-child { width: 45%; background: var(--accent); opacity: 0.6; }
  .wgi-mock__pane--1 { left: 0; transform: rotate(-6deg); z-index: 1; }
  .wgi-mock__pane--2 { left: 18%; transform: rotate(2deg); z-index: 2; }
  .wgi-mock__pane--3 { left: 36%; transform: rotate(8deg); z-index: 1; }
  .wgi-mock__glass { position: absolute; left: 4%; bottom: 0; z-index: 3; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--bg-raised); border: var(--rule-width) solid var(--ink); color: var(--ink); }

  .wgi-mock--bundle { flex-direction: column; align-items: stretch; height: auto; gap: var(--space-2); }
  .wgi-mock__row { display: flex; align-items: center; gap: var(--space-2); padding: 0.4em 0.6em; border-radius: 6px; border: var(--rule-width) solid var(--line); background: var(--bg); }
  .wgi-mock__row-bar { flex: 1; height: 6px; border-radius: 3px; background: var(--line); }
  .wgi-mock__radio { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--line); flex-shrink: 0; }
  .wgi-mock__row--hi { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--bg)); }
  .wgi-mock__radio--on { border-color: var(--accent); background: var(--accent); }
  .wgi-mock__row-tag { font-size: 0.6rem; color: var(--accent-deep); text-transform: uppercase; letter-spacing: var(--tracking-caps); }

  .wgi-mock--checklist { flex-direction: column; align-items: stretch; height: auto; gap: var(--space-2); }
  .wgi-mock__check { display: flex; align-items: center; gap: var(--space-2); color: var(--ink-50); }
  .wgi-mock__check.is-on { color: var(--accent-deep); }
  .wgi-mock__check-bar { display: block; width: 70%; height: 8px; border-radius: 2px; background: color-mix(in srgb, currentColor 30%, var(--line)); }
  .wgi-mock__check-bar--off { width: 50%; }
  .wgi-mock__check-ring { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--line); flex-shrink: 0; }

  .wgi-mock--reviews { flex-direction: column; align-items: stretch; height: auto; gap: var(--space-2); }
  .wgi-mock__top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap; }
  .wgi-mock__stars { color: var(--accent); letter-spacing: 1px; font-size: 0.85rem; }
  .wgi-mock__count { color: var(--ink-50); font-size: var(--fs-small); }
  .wgi-mock__sizes { display: inline-flex; gap: 4px; }
  .wgi-mock__sizes span { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 4px; border: var(--rule-width) solid var(--line); font-size: 0.6rem; color: var(--ink-50); }
  .wgi-mock__sizes span.is-on { border-color: var(--ink); color: var(--ink); background: var(--bg); }
  .wgi-mock__meter { display: block; height: 5px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .wgi-mock__meter-fill { display: block; width: 94%; height: 100%; background: var(--accent); }

  .wgi-mock--gallery { gap: var(--space-2); height: 2.75rem; }
  .wgi-mock__thumb { flex: 1; height: 100%; border-radius: 6px; background: var(--bg); border: var(--rule-width) solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--ink-50); }
  .wgi-mock__thumb--play { color: var(--accent-deep); border-color: var(--accent); }

  .wgi-mock--trust { flex-direction: column; align-items: stretch; height: auto; gap: var(--space-1); }
  .wgi-mock__chip { display: inline-flex; align-items: center; gap: 0.4em; padding: 0.3em 0.7em; border-radius: 999px; border: var(--rule-width) solid var(--line); background: var(--bg); font-size: 0.7rem; color: var(--ink-soft); }
  .wgi-mock__chip--accent { border-color: var(--accent); color: var(--accent-deep); }

  .wgi-mock--phone { justify-content: center; height: 4.5rem; }
  .wgi-mock__phone { position: relative; width: 2.4rem; height: 100%; border-radius: 8px; border: var(--rule-width) solid var(--line); background: var(--bg); overflow: hidden; padding: 6px 5px; display: flex; flex-direction: column; gap: 4px; }
  .wgi-mock__phone-row { display: block; height: 6px; border-radius: 2px; background: var(--line); }
  .wgi-mock__phone-row--sm { width: 60%; }
  .wgi-mock__phone-cta { margin-top: auto; display: block; height: 10px; border-radius: 3px; background: var(--accent); }

  .wgi-mock--speed { justify-content: center; gap: var(--space-6); }
  .wgi-mock__bar-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 4px; }
  .wgi-mock__bar { width: 1.2rem; border-radius: 3px 3px 0 0; background: var(--line); }
  .wgi-mock__bar--slow { height: 100%; }
  .wgi-mock__bar--fast { height: 45%; background: var(--accent); }
  .wgi-mock__bar-label { font-size: 0.6rem; color: var(--ink-50); }

  .wgi-mock--cart { flex-direction: column; align-items: stretch; height: auto; gap: var(--space-2); }
  .wgi-mock__line { display: block; height: 8px; border-radius: 2px; background: var(--line); }
  .wgi-mock__line--sm { width: 65%; }
  .wgi-mock__pay { align-self: flex-start; display: inline-flex; align-items: center; gap: 0.35em; margin-top: 2px; padding: 0.35em 1.1em; border-radius: 999px; background: var(--accent); color: var(--bg-raised); font-size: 0.7rem; font-weight: var(--fw-body-semi); }

  /* ---------- mock hover motion: each symbol comes alive on card hover
     (kept as brief keyframe replays rather than resting-state changes, so
     the collapsed/default look is never broken). Reduced-motion users get
     the global 0.001ms override already applied sitewide. ---------- */
  .wgi-mock { transition: transform 300ms var(--ease-out); }
  .wgi-card:hover .wgi-mock { transform: scale(1.04); }

  .wgi-mock__pane, .wgi-mock__glass { transition: transform 300ms var(--ease-out); }
  .wgi-card:hover .wgi-mock__pane--1 { transform: rotate(-15deg) translate(-3px, -2px); }
  .wgi-card:hover .wgi-mock__pane--2 { transform: rotate(0deg) translateY(-3px); }
  .wgi-card:hover .wgi-mock__pane--3 { transform: rotate(17deg) translate(3px, -2px); }
  .wgi-card:hover .wgi-mock__glass { transform: scale(1.25) rotate(-10deg); }

  .wgi-mock__row--hi { transition: transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out); }
  .wgi-card:hover .wgi-mock__row--hi { transform: translateX(4px); box-shadow: 0 8px 16px -10px color-mix(in srgb, var(--accent) 60%, transparent); }

  .wgi-mock__check.is-on svg { transition: transform 250ms var(--ease-out); }
  .wgi-card:hover .wgi-mock__check.is-on:nth-of-type(1) svg { transform: scale(1.35); }
  .wgi-card:hover .wgi-mock__check.is-on:nth-of-type(2) svg { transition-delay: 100ms; transform: scale(1.35); }

  @keyframes wgi-meter-fill { from { width: 20%; } to { width: 94%; } }
  .wgi-card:hover .wgi-mock__meter-fill { animation: wgi-meter-fill 600ms var(--ease-out); }
  .wgi-mock__stars { transition: letter-spacing 300ms var(--ease-out); }
  .wgi-card:hover .wgi-mock__stars { letter-spacing: 3px; }

  @keyframes wgi-play-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.3); } }
  .wgi-card:hover .wgi-mock__thumb--play svg { animation: wgi-play-pulse 800ms var(--ease-io) infinite; }

  .wgi-mock__chip { transition: transform 250ms var(--ease-out); }
  .wgi-card:hover .wgi-mock__chip:nth-child(1) { transform: translateX(4px); }
