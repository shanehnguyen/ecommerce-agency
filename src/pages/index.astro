  .closing__inner p { margin-top: var(--space-4); font-family: var(--font-serif); font-size: var(--fs-bodyL); line-height: 1.65; color: var(--dark-soft); max-width: 56ch; margin-inline: auto; }
  .closing__alt { font-size: var(--fs-body) !important; }
  .closing__alt a { color: var(--dark-ink); font-weight: var(--fw-body-bold); text-decoration: underline; text-underline-offset: 3px; }
  .closing__alt a:hover { color: var(--accent-strong); }
  .closing__cta { margin-top: var(--space-8); }
  .closing__sig { margin-top: var(--space-8) !important; font-family: var(--font-display) !important; font-size: var(--fs-h4) !important; color: var(--dark-ink) !important; }



