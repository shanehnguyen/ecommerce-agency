  /* visitors toolbar */
  .pl-tbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .pl-tbar__controls { display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center; }
  .pl-search, .pl-filter { font-family: var(--font-body); font-size: var(--fs-body-sm, var(--fs-caption)); padding: 6px 10px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: #fff; color: var(--ink); }
  .pl-search { min-width: 12rem; }
  .pl-hint { margin-top: var(--space-2); font-size: var(--fs-caption); color: var(--ink-50); }

  /* scrollable data table */
  .pl-tscroll { margin-top: var(--space-4); overflow: auto; max-height: 74vh; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .pl-table { border-collapse: separate; border-spacing: 0; font-family: var(--font-mono); font-size: var(--fs-caption); white-space: nowrap; min-width: 100%; }
  .pl-table th, .pl-table td { padding: 6px 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .pl-table thead th { position: sticky; top: 0; z-index: 2; background: #fff; cursor: pointer; user-select: none; text-transform: uppercase; letter-spacing: 0.03em; color: var(--ink-50); font-weight: var(--fw-body-semi); box-shadow: 0 1px 0 var(--line); }
  .pl-table thead th:hover { color: var(--ink); }
  .pl-table th.is-sorted { color: var(--ink); }
  .col-biz { position: sticky; left: 0; z-index: 1; background: #fff; min-width: 11rem; box-shadow: 1px 0 0 var(--line); }
  .pl-table thead th.col-biz { z-index: 3; }
  .pl-tr { cursor: pointer; }
  .pl-tr:hover td { background: color-mix(in srgb, var(--accent) 6%, #fff); }
