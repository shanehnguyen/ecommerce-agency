    22%, 78% { transform: scaleY(1); }
    90%      { transform: scaleY(1.04); }
    100%     { transform: scaleY(1); }
  }
  .op__trend { position: absolute; inset: 12% 10% 10%; width: auto; height: auto; overflow: visible; }
  .op__trend polyline {
    fill: none; stroke: var(--bp-optimize); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
    vector-effect: non-scaling-stroke; stroke-dasharray: 150; stroke-dashoffset: 150;
