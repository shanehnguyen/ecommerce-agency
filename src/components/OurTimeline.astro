---
/* OurTimeline — "04. Our Timeline": replaces the old horizontal 4-dot
   Timeline.astro with the public/ourplaybook-inspo layout (eyebrow + headline
   header, 4 big numbered rows below). The reference's symbol panel was cut —
   4 plain numbered rows read clearly enough on their own without it.
   Click/tap toggles which row is open (.is-open, accordion-style — one at a
   time, via the tiny script below), and that's the ONLY thing that controls
   the description text. Hover/focus only brightens the row's own text — it
   deliberately does NOT reveal the description: opening a row grows the
   list (the description takes space), which shifts the rows below it out
   from under an unmoved mouse, so a hover-driven reveal kept fighting the
   click a moment later. Row 1 starts pinned open so the list is never
   empty on load. */
const steps = [
  {
    n: '01', label: 'Strategy Session',
    desc: 'We pull apart your category and build your exact game plan before writing a line of code.',
  },
  {
    n: '02', label: 'Website Launch',
    desc: 'Your new site goes live, benchmarked against your old numbers from day one.',
  },
  {
    n: '03', label: 'More Conversions',
    desc: 'Real numbers move: add-to-cart rate, checkout drop-off, mobile vs. desktop.',
  },
  {
    n: '04', label: 'Rinse and Repeat',
    desc: 'We keep optimizing until the numbers speak for themselves.',
  },
];
---
<section class="ourtl" id="timeline">
  <div class="container">
    <div class="ourtl__head">
      <p class="eyebrow-num mono">04. Our Timeline</p>
      <h2 class="ourtl__headline">14 days from handshake to more conversions. <span class="ourtl__headline-sm">No onboarding decks. No agency theater.</span></h2>
    </div>
    <div class="ourtl__rule" aria-hidden="true"></div>

    <ol class="ourtl__list">
      {steps.map((s, i) => (
        <li
          class:list={['ourtl__row', { 'is-open': i === 0 }]}
          tabindex="0" role="button" aria-expanded={i === 0 ? 'true' : 'false'}
        >
          <span class="ourtl__row-head">
            <span class="ourtl__n mono" aria-hidden="true">#{s.n}</span>
            <h3 class="ourtl__label">{s.label}</h3>
          </span>
          <p class="ourtl__desc mono">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Hover/focus-visible preview is pure CSS (see :has() rules below); click
  // additionally PINS a row open (accordion — one at a time), which is the
  // only way this interaction can work on touch, where hover never fires.
  document.querySelectorAll('.ourtl__list').forEach((list) => {
    // guards against double-wiring (e.g. dev-server hot-reload re-running
    // this script on the same DOM) — two click listeners on one row would
    // toggle it open then immediately closed again on every real click.
    if (list.dataset.ourtlWired) return;
    list.dataset.ourtlWired = 'true';
    const rows = Array.from(list.querySelectorAll('.ourtl__row'));
    rows.forEach((row) => {
      row.addEventListener('click', () => {
        const wasOpen = row.classList.contains('is-open');
        rows.forEach((r) => { r.classList.remove('is-open'); r.setAttribute('aria-expanded', 'false'); });
        if (!wasOpen) { row.classList.add('is-open'); row.setAttribute('aria-expanded', 'true'); }
      });
      row.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        row.click();
      });
    });
  });
</script>

<style>
  .ourtl { padding-block: clamp(2.5rem, 7vh, 5rem); }

  .ourtl__head { display: flex; flex-direction: column; gap: var(--space-3); }
  @media (min-width: 48em) {
    .ourtl__head { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--space-10); }
    .ourtl__head .eyebrow-num { flex-shrink: 0; padding-top: 0.3em; }
  }
  .ourtl__headline { max-width: 42ch; font-size: clamp(1.5rem, 3vw, 2.25rem); }
  .ourtl__headline-sm { display: block; margin-top: var(--space-2); font-size: clamp(0.9375rem, 1.2vw, 1.125rem); color: var(--ink-soft); }

  .ourtl__rule { margin-top: var(--space-4); border-top: var(--rule-width) solid var(--line); }

  .ourtl__list { margin-top: var(--space-4); list-style: none; padding: 0; }
  .ourtl__row {
    padding-block: var(--space-4); border-top: var(--rule-width) solid var(--line);
    opacity: 0.45; transition: opacity 250ms var(--ease-out); cursor: pointer;
  }
  .ourtl__row:last-child { border-bottom: var(--rule-width) solid var(--line); }
  .ourtl__row.is-open, .ourtl__row:hover, .ourtl__row:focus-visible { opacity: 1; }

  .ourtl__row-head { display: flex; align-items: baseline; gap: var(--space-4); }
  .ourtl__n { font-size: var(--fs-body); color: var(--accent-deep); }
  .ourtl__label { font-size: clamp(1.5rem, 3.4vw, 2.25rem); }

  /* only reacts to .is-open (click/tap) — see the top-of-file comment for why
     hover deliberately doesn't also reveal this */
  .ourtl__desc {
    max-height: 0; opacity: 0; overflow: hidden; margin-top: 0;
    font-size: var(--fs-caption); color: var(--ink-soft);
    transition: max-height 300ms var(--ease-out), opacity 200ms var(--ease-out), margin-top 300ms var(--ease-out);
  }
  .ourtl__row.is-open .ourtl__desc { max-height: 3rem; opacity: 1; margin-top: var(--space-2); }
</style>
