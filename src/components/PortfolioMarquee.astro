---
/* PortfolioMarquee — mobile-only. Desktop already shows all 6 portfolio
   cards in PortfolioGrid's 2-column layout up top, so this stays hidden
   there. On mobile, PortfolioGrid only shows the first 3 cards (see its
   own comment) — this strip carries the other 3, placed right under the
   pricing cards, as a slow auto-scrolling track instead of another static
   grid to scroll through. One card fills the frame at a time; the track
   is the card set duplicated once and animated -50% (same seamless-loop
   technique as WhatGoesIn's ingredient ticker), so it drifts continuously
   left with no visible seam or snap. */
import PortfolioTile from './PortfolioTile.astro';
import { portfolioCards } from '../data/portfolio';
import { site } from '../data/site.config';

const rest = portfolioCards.slice(3);
---
<section class="pfm">
  <p class="pfm__label mono">Apply now. I only take {site.scarcity.slotsOpen} builds a month.</p>
  <div class="pfm__viewport" data-reveal>
    <div class="pfm__track">
      {rest.map((c) => <div class="pfm__item"><PortfolioTile card={c} /></div>)}
      {rest.map((c) => <div class="pfm__item" aria-hidden="true"><PortfolioTile card={c} /></div>)}
    </div>
  </div>
</section>

<script>
  /* Auto-drift for the (now natively scrollable) strip. A float `pos` is
     the source of truth — scrollLeft rounds to ints in some engines, and
     adding a sub-pixel speed to a rounded value every frame would stall.
     Touching pauses the drift; it resumes 2s after the finger lifts. The
     card set is duplicated in the markup, so wrapping scrollLeft back by
     one set-width lands on identical pixels — an invisible seam. */
  const viewport = document.querySelector<HTMLElement>('.pfm__viewport');
  const track = document.querySelector<HTMLElement>('.pfm__track');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (viewport && track && !reduce) {
    const SPEED = 0.04; // px per ms ≈ the old 26s CSS loop
    let paused = false;
    let resumeTimer = 0;
    let pos = 0;
    let last = 0;

    const period = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (track.scrollWidth + gap) / 2;
    };

    viewport.addEventListener('touchstart', () => { paused = true; clearTimeout(resumeTimer); }, { passive: true });
    const scheduleResume = () => {
      clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => { paused = false; }, 2000);
    };
    viewport.addEventListener('touchend', scheduleResume, { passive: true });
    viewport.addEventListener('touchcancel', scheduleResume, { passive: true });
    // while the user (or their momentum) is scrolling, track the real
    // position so the drift resumes from wherever they left it
    viewport.addEventListener('scroll', () => { if (paused) pos = viewport.scrollLeft; }, { passive: true });

    const step = (ts: number) => {
      if (!last) last = ts;
      const dt = Math.min(ts - last, 100); // clamp tab-switch gaps
      last = ts;
      if (!paused) {
        const p = period();
        pos += SPEED * dt;
        if (p > 0 && pos >= p) pos -= p;
        viewport.scrollLeft = pos;
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
</script>

<style>
  /* desktop already shows these 3 in PortfolioGrid — this strip is
     mobile-only, matching PortfolioGrid's own 60em breakpoint.
     Negative margin-top pulls the strip up into the pricing section's own
     bottom padding (clamp(2.5rem, 7vh, 5rem)) so the label reads as part
     of the cards above instead of floating in a double-padded gap. Safe
     because this strip only ever renders directly under #pricing. */
  .pfm { display: block; margin-top: clamp(-3.5rem, -5vh, -1.5rem); padding-block: 0 clamp(1.5rem, 4vh, 2.5rem); }
  @media (min-width: 60em) { .pfm { display: none; } }

  .pfm__label {
    text-align: center; margin-bottom: var(--space-3);
    font-size: var(--fs-small); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--ink-50);
  }

  /* a REAL scroll container (not a CSS transform loop): the finger drags it
     natively with momentum, and the script below drifts it while idle. The
     scrollbar is hidden — the drift + the peeking next card signal
     "this slides" without chrome. */
  .pfm__viewport {
    overflow-x: auto; padding-block: var(--space-1);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .pfm__viewport::-webkit-scrollbar { display: none; }
  .pfm__track { display: flex; gap: var(--space-3); width: max-content; }

  /* one card fills the frame — a sliver of the next peeks in from the gap,
     which is what reads as "sliding to the next one" rather than a hard cut */
  .pfm__item { flex: 0 0 86vw; max-width: 28rem; }

  /* reduced motion: the script skips the auto-drift — swipe-only, with snap */
  @media (prefers-reduced-motion: reduce) {
    .pfm__viewport { scroll-snap-type: x mandatory; }
    .pfm__item { scroll-snap-align: center; }
  }
</style>
