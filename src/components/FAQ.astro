---
/* FAQ — plain details/summary accordions + FAQPage schema.org markup.
   No animations by request: no scroll reveal, no slide, no icon spin —
   items open and close instantly. Doubles as on-page SEO (spec §5 / §6). */
import type { Faq, FaqBlock, FaqBullet, FaqGroup } from '../data/faqs';
/* Pass a flat `items` list, or `groups` to show short section labels between
   questions. `headingTag` sets the label level to fit the page's outline. */
interface Props { items?: Faq[]; groups?: FaqGroup[]; headingTag?: 'h2' | 'h3'; }
const { items: flat, groups, headingTag: H = 'h2' } = Astro.props;
const sections: FaqGroup[] = groups ?? [{ title: '', items: flat ?? [] }];
const items = sections.flatMap((g) => g.items);
// "What’s Included" → "whats-included", for #anchor links to a section
const faqSlug = (t: string) => t.toLowerCase().replace(/[’']/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Inline markup → HTML: escape first, then **bold** and [text](/path).
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const inline = (s: string) => esc(s)
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');
const bulletHtml = (b: FaqBullet): string => typeof b === 'string'
  ? `<li>${inline(b)}</li>`
  : `<li>${inline(b.text)}<ul>${b.list.map((x) => `<li>${inline(x)}</li>`).join('')}</ul></li>`;
const blockHtml = (b: FaqBlock) => typeof b === 'string'
  ? `<p>${inline(b)}</p>`
  : `<ul>${b.list.map(bulletHtml).join('')}</ul>`;
const answerHtml = (a: Faq['a']) => (Array.isArray(a) ? a : [a]).map(blockHtml).join('');

// Plain text for the schema: markup stripped, list items joined.
const plain = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '$1').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const bulletText = (b: FaqBullet): string => typeof b === 'string' ? plain(b) : [plain(b.text), ...b.list.map(plain)].join(' ');
const answerText = (a: Faq['a']) => (Array.isArray(a) ? a : [a])
  .map((b) => typeof b === 'string' ? plain(b) : b.list.map(bulletText).join(' ')).join(' ');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: answerText(f.a) },
  })),
};
---
{sections.map((g) => (
  <div class="faq__section" id={g.title ? faqSlug(g.title) : undefined}>
    {g.title && <H class="faq__group">{g.title}</H>}
    <div class="faq">
      {g.items.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span>{f.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a-wrap">
            <div class="faq__a" set:html={answerHtml(f.a)} />
          </div>
        </details>
      ))}
    </div>
  </div>
))}
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq { border-top: var(--rule-width) solid var(--rule); }
  .faq__section + .faq__section { margin-top: var(--space-10); }
  .faq__section { scroll-margin-top: 6rem; }
  .faq__group { font-size: var(--fs-caption); color: var(--accent-deep); margin-bottom: var(--space-3); text-align: left; }
  .faq__item { border-bottom: var(--rule-width) solid var(--rule); }
  .faq__q {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-5) 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); text-transform: none; font-size: var(--fs-h4);
    color: var(--ink); font-weight: var(--fw-display);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; background: var(--brass); }
  .faq__icon::before { top: 7px; left: 0; width: 16px; height: 2px; }
  .faq__icon::after { left: 7px; top: 0; width: 2px; height: 16px; }
  /* the "+" turned 45° reads as "×" (instant, no transition) */
  .faq__item[open] .faq__icon { transform: rotate(45deg); }

  .faq__a { padding-bottom: var(--space-5); max-width: 65ch; }
  /* answer HTML comes in via set:html, so these need :global to reach it */
  .faq__a :global(p), .faq__a :global(li) { color: var(--ink-70); line-height: 1.6; }
  .faq__a :global(* + p), .faq__a :global(* + ul) { margin-top: var(--space-3); }
  .faq__a :global(ul) { padding-left: var(--space-5); list-style: disc; }
  .faq__a :global(ul ul) { margin-top: var(--space-2); list-style: circle; }
  .faq__a :global(li + li) { margin-top: var(--space-1); }
  .faq__a :global(strong) { color: var(--ink); font-weight: var(--fw-body-semi); }
  .faq__a :global(a) { color: var(--ink); }
</style>
