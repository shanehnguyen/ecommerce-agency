  .op__bar--4 { height: 94%; animation-delay: 360ms; background: color-mix(in srgb, var(--bp-optimize) 26%, var(--bg-raised)); border-color: color-mix(in srgb, var(--bp-optimize) 42%, var(--line)); }
  [data-reveal].is-in .op__bar { animation-play-state: running; }
  @keyframes op-grow {
