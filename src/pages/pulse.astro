  .pl-dim { color: var(--ink-50); font-weight: var(--fw-body-regular); font-size: var(--fs-caption); font-family: var(--font-mono); }

  /* funnel */
  .pl-funnel { margin-top: var(--space-5); display: grid; gap: var(--space-4); }
