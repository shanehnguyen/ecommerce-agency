</style>

<!-- Global (not scoped): the tiles, table, funnel bars and badges are built with
     innerHTML in the script, so they never carry Astro's scope attribute - scoped
     rules would silently skip them. Every selector here is pl-* prefixed and this
     page stands alone, so global is safe. -->
