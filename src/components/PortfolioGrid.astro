---
/* PortfolioGrid — static grid, no carousel/marquee: 2 columns on desktop
   (>=60em), single column on mobile. Each tile shows the client name on
   top and the result stat on the bottom, same as before. Yun Hai Shop and
   Cited Supplements are pulled for now (not permanently gone — see git
   history for their card entries when they're ready to go back in).
   Mobile only shows the first 3 (cards 4-6 hidden below 60em) so the page
   doesn't scroll forever before reaching pricing — the rest reappear
   further down in PortfolioMarquee, right under the pricing cards. Card
   data now lives in src/data/portfolio.ts, shared with PortfolioMarquee. */
import PortfolioTile from './PortfolioTile.astro';
import { portfolioCards } from '../data/portfolio';
---
<div class="pf-grid">
  {portfolioCards.map((c) => <PortfolioTile card={c} />)}
</div>

<style>
  /* mobile: padding-inline matches the row gap so each tile sits with the
     same amount of space on all four sides (top/bottom from the gap,
     left/right from the viewport edge) instead of edge-to-edge horizontally
     but gapped vertically. */
  .pf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding-inline: var(--space-3);
    max-width: 32rem;
    margin-inline: auto;
  }

  /* mobile: only the first 3 cards show up here — cards 4-6 are still in
     the DOM (fine for SEO/accessibility) but hidden, since they reappear
     in the PortfolioMarquee strip under pricing. */
  .pf-grid :global(.pf-tile:nth-child(n+4)) { display: none; }

  @media (min-width: 60em) {
    .pf-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-5); padding-inline: 0; max-width: var(--container-standard); }
    .pf-grid :global(.pf-tile:nth-child(n+4)) { display: block; }
  }
</style>
