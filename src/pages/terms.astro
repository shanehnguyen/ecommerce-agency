---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.config';
---
<BaseLayout title="Terms of Service" description={`The terms for using the ${site.brand} website, forms, and text messages.`} noindex={true}>
  <section class="section legal">
    <div class="container container--prose">
      <h1>Terms of Service</h1>
      <p class="legal__date mono">Last updated September 2026</p>
      <!-- LEGAL REVIEW REQUIRED before launch. Plain-language draft only. -->
      <p>
        This site is operated by {site.legalName} (“{site.brand},” “we”).
        These terms cover use of the {site.brand} website and its application and booking forms. Using the
        site means you agree to them. Our <a href="/privacy">Privacy Policy</a> explains how we handle your information.
      </p>
      <h2>Eligibility</h2>
      <p>
        You must be at least 18 years old to use this site, submit an application, or opt in to text messages.
        By doing so, you confirm that you are 18 or older.
      </p>
      <h2>Client work is governed by a signed agreement</h2>
      <p>
        Nothing on this website is a contract for services. Every engagement has its own written agreement that
        sets out the scope, fees, payment schedule, timeline, and any guarantees or warranties that apply. If
        anything on this site differs from your signed agreement, the agreement controls.
      </p>
      <h2>Results</h2>
      <p>
        Results described on this site, including case studies and conversion figures, reflect specific projects.
        They are not a promise of the same outcome for your store, which depends on your products, traffic, and market.
      </p>
      <h2 id="sms">SMS terms</h2>
      <p>
        <strong>Program.</strong> {site.brand} sends text messages about your application, call reminders, and
        project updates to people 18 or older who check the SMS consent box on our application form.
      </p>
      <p>
        <strong>Opt-in is optional.</strong> Consent to receive texts is not a condition of purchase. You can
        apply and work with us without it.
      </p>
      <p>
        <strong>Frequency and cost.</strong> Message frequency varies. Message and data rates may apply,
        according to your mobile plan.
      </p>
      <p>
        <strong>Opting out.</strong> Reply <strong>STOP</strong> to any message to stop receiving texts. You’ll
        get one confirmation message and no further texts unless you opt in again.
      </p>
      <p>
        <strong>Help.</strong> Reply <strong>HELP</strong> for help, or contact
        <a href={`mailto:${site.email}`}>{site.email}</a> or {site.phone}.
      </p>
      <p>
        <strong>Carriers.</strong> Mobile carriers are not liable for delayed or undelivered messages.
      </p>
      <p>
        <strong>Privacy.</strong> See the <a href="/privacy#sms">SMS section of our Privacy Policy</a>. We never
        share your mobile number or opt-in consent with third parties for marketing.
      </p>

      <h2>Contact</h2>
      <p>
        {site.legalName}<br />
        {site.location.label}<br />
        <a href={`mailto:${site.email}`}>{site.email}</a> · {site.phone}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal h1 { font-family: var(--font-display); }
  .legal__date { color: var(--ink-50); font-size: var(--fs-caption); margin-block: var(--space-2) var(--space-6); }
  .legal h2 { font-family: var(--font-display); text-transform: none; font-size: var(--fs-h3); margin-top: var(--space-8); }
  .legal p, .legal li { color: var(--ink-70); margin-top: var(--space-3); line-height: 1.6; }
</style>
